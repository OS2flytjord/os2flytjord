<?xml version="1.0" encoding="utf-8" ?>
<!-- Logning i integrationstestene: advarsler og fejl skrives til konsollen, så de ses i testens output
     (fx exceptions, som koden fanger og kun logger). -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target name="konsol" xsi:type="Console" layout="${level:uppercase=true} ${logger}: ${message} ${exception:format=ToString}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Warn" writeTo="konsol" />
  </rules>
</nlog>
