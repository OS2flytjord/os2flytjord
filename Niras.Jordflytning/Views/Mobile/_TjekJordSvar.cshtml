@model Niras.Jordflytning.ViewModels.Mobile.TjekJordSvarModel

@{
	Layout = null;
}

@Html.HiddenFor(m=>m.Forureningskode, new{id="hfForureningskodeTjekJordSvar"})

<div data-role="collapsible-set">
	<div data-role="collapsible"  data-collapsed="false">
		<h3>Anmeldepligtig jord?
		</h3>
		<div id="txtAnmelderpligtigJord" data-controltype="textblock">
			<p>
				<b>
					@if (Model.AnmelderpligtigJord)
		 {
						<text><b>Det ER nødvendig at lave en anmeldelse.</b><br />
						<br /></text>
		 }
		 else
		 {
						<text>Ved opslag i eksterne systemer er der ingen oplysninger om jordforurening på ejendommen. <br/>
            <b>Det er IKKE nødvendig at lave en anmeldelse.</b><br />
            Jorden kan bortskaffes som ren jord. 
          <br /></text>
		 }
				</b>
			</p>
		</div>
	</div>
	<div data-role="collapsible">
		<h3>Forureningsstatus
		</h3>
		<div id="txtForureninstatus" data-controltype="textblock">
		  
		     @if (Model.ForureningOpslagResultatList != null && Model.ForureningOpslagResultatList.Count > 0)
        {
          //Gruppering efter Headertekst
          var groups = (from g in Model.ForureningOpslagResultatList select g.Header).Distinct().ToList();
          var taeller = 0;
          foreach (var gg in groups)
          {
            <b>@gg</b><br/>

            var rr = (from r in Model.ForureningOpslagResultatList where r.Header == gg select r).ToList();
            foreach (var row in rr)
            {
              taeller++;
              @row.ShortText
              <br />
              <div style="color: blue;cursor: pointer" onclick="toogleForureningsopslagDiv(@(taeller))">Klik her for nærmere info.</div>
                <div id="divForureningOpslagRow@(taeller)" style="display: none;">
                    @Html.Raw(@row.LongText)                   
                </div>
              <br />
              <br />
            }
          }
        }
		  
			<p>
				<span style="text-decoration: underline;" data-mce-style="text-decoration: underline;">&nbsp;
				</span>
			</p>
		</div>
	</div>
</div>
