                            columns.Command(c => c.Destroy().Text("Fjern"));
                        })
                    .Selectable(selectable => selectable.Mode(GridSelectionMode.Single))
                    .Editable(ed => ed.DisplayDeleteConfirmation("Vil du fjerne filen?"))
                    .AutoBind(true)
                    .HtmlAttributes(new { style = "min-height:65px; margin-top:5px" })
                    .DataSource(dataSource => dataSource
                                                .Ajax() // Specify that the data source is of ajax type
                                                .Read(read => read.Action("ReadAnalyseDokumentation", "Anmeldelser")) 
                                                .Model(model => model.Id(p => p.Id))
                                                .Destroy(des => des.Action("RemoveFileAnalysedocs", "Anmeldelser"))
                    ))

            <input type="button" id="btnShowWinFileAfslutUpload" value="Vedhæft analysedokument" style="margin-top:10px; margin-bottom: 15px"/>
  
        </div>

  
        <input type="submit" id="btnAfslutMedAnalysedocs" value="Afslut" class="toolbarButton" style="margin-left:120px; width:60px; margin-right:20px;"/>
        <input type="submit" id="btnCloseAfslutMedAnalysedocs" value="Annullér" class="toolbarButton" style="margin-left:0; width:60px; margin-right:20px;" />

    }
</div>

<div id="uploadVedAfslutFilesWindow" style="display: none">
    <div class="row_line" id="jorden_doctype" style="margin-left: 10px">
        @Html.Label("lblDokumentationType", "Dokument type")
        @(Html.Kendo().DropDownList()
              .Name("drpAfslutDocType")
              .DataTextField("Text")
              .DataValueField("Value")
              .OptionLabel("Vælg")
              .Value("-")
              .BindTo(Model.DokumentationTypeListe.Where(x => x.Text.StartsWith("analyse", StringComparison.InvariantCultureIgnoreCase)).ToArray()))
    </div>
    <div class="row_line" style="margin-left: 10px">
        @Html.Label("Dokument dato")
        @Html.Kendo().DatePicker().Name("datAfslutDocDate").Value(DateTime.Now).HtmlAttributes(new { type = "text", data_tooltip = "Angiv dato for tilblivelsen af dokumentet" })
    </div>
    <div class="row_line" style="margin-left: 10px">
        @Html.Label("lbSize", "Max. filstørrelse: 50 MB")
        <br />
    </div>
    <div class="row_line" style="margin-left: 10px">
        @(Html.Kendo().Upload()
              .Name("files")
              .HtmlAttributes(new { @onclick = "if($('#drpAfslutDocType').val().length <= 1) { alert('Før du kan upload dokument, skal du vælge dokument type.'); return false; }" })
              .Messages(m => m.Select("Vælg fil..."))
              .Async(a => a
                              .Save("SaveFileAnalysedocs", "Anmeldelser")
                              .Remove("RemoveFile", "Anmeldelser")
                              .AutoUpload(true)
              )
              .Events(events => events
                                    .Success("onAfslutFileSuccess")
                                    .Upload("onAfslutFileUpload")
                                    .Error("onAfslutError")
              )
              .ShowFileList(false)
        )
    </div>
</div>

<div id="winGennemse" style="display: none;">
    <div id="gennemseIndhold">
        <!-- Dynamisk indhold -->
    </div>
    <input style="width: 125px;" id="btnAfsend" name="execute" type="button" value="Indsend" class="toolbarButton" />
    <input style="width: 125px;" id="btnGennemseLuk" type="button" value="Annullér" class="toolbarButton" />
</div>

<div id="winFinish" style="display: none;">
    Anmeldelsen er nu afsend.<br />
</div>

<div id="winModtagerAnlaegKort" style="display: none">
    @*Modal vindue til visning af modtagerAnlaeget i kortet.*@
</div>

<div id="winModtagerAnlaegDokumenter" style="display: none">
    @*Modal vindue til visning af modtagerAnlaegets dokumenter.*@
</div>

<script type="text/javascript">
    $(document).ready(function() {
        if (@Model.Revision.ToString().ToLower() && visRevision) {
            $("div[class*='tab_right_arrow']").each(function(index, element) {
                var idx = $(this).attr("id").split("_")[1];
                $("div[id*='tab_']").attr("class", "tab_right_arrow");
                var tabContentId = "tabContent_" + idx;
                $("#" + tabContentId).attr("class", "tabContent disabled");
            });

            $("div[id='tab_6']").attr("class", "tab_right_arrow_active");
            $("#tabContent_6").attr("class", "tabContent");
        }

        var winAfslutUpload = Jordflytning.ui.createModalWindow("winSendAfslutEvtMedDokumenterForm", 223, 530, "Afslut anmeldelse", false);

        $("#btnShowWinAfslutUpload").click(function (e) {
            e.preventDefault();
            winAfslutUpload.center();
            winAfslutUpload.open();
        });

        var winFileUploadAfslut = Jordflytning.ui.createModalWindow("uploadVedAfslutFilesWindow", 180, 430, "Vedhæft analysedokument", false);

        $("#btnShowWinFileAfslutUpload").click(function (e) {
            e.preventDefault();
            winFileUploadAfslut.center();
            winFileUploadAfslut.open();
        });

        /* Parse the querystring */
        var tabParameter = Jordflytning.url.getParameter("tab");
        if (tabParameter != null) {
            $('#tabs').find('[data-tab="' + tabParameter + '"]').click();
        };
    });



    function onAfslutError(e) {
        // Array with information about the uploaded files
        if (e.operation == "upload") {
            alert("Filen er for stor!");
        }
    }

    function onAfslutFileUpload(e) {
        e.data = {
            dokumentationTypeId: $("#drpAfslutDocType").val(),
            metadataDato: $("#datAfslutDocDate").val(),
            anmeldelseId: $("#hflAnmeldelseId").val()
        };
    }

    function onAfslutFileSuccess() { 
        $("#GridAnalyseDokumenter").data("kendoGrid").dataSource.read();
        $(".k-upload-files.k-reset").find("li").remove();
        $("#uploadVedAfslutFilesWindow").data("kendoWindow").close();
    }
 

    $("#btnCloseAfslutMedAnalysedocs").click(function(e){
        e.preventDefault();
        $("#winSendAfslutEvtMedDokumenterForm").data("kendoWindow").close();
    });


</script>
