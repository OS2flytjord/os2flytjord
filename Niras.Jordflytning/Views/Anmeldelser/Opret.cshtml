                    <a id="info-opret" style="float: right; height: 16px; width: 16px; border: 0; margin-top: 6px; margin-left: -7px; margin-right: 10px; cursor: pointer;" href="https://youtu.be/wOsUV6kwFw4" target="_blank">
                        <img src="/Content/Icons/info_button.png" style="height: 16px; width: 16px; border: 0px; margin-right: 10px;" />
                    </a>
