                <img src="~/Content/Icons/loading.gif" />
            </div>
        </div>

        <div id="tabs" style="float: left;">
            <div id="tab_1" data-tab="sted" class="tab_right_arrow_active">1. Sted</div>
            <div id="tab_2" data-tab="jorden" class="tab_right_arrow">2. Jorden</div>
            <div id="tab_3" data-tab="modtager-transportoer" class="tab_right_arrow" style="width: 210px;">3. Modtager og transportør</div>

            <div id="tab_4" data-tab="betaler" class="tab_right_arrow" style="display:@(Model.Anmeldelse != null && Model.Anmeldelse.ModtagerAnlaeg != null && Model.Anmeldelse.ModtagerAnlaeg.AnvenderJF ? "block" : "none")">4. Betaler</div>
            <div id="tab_5" data-tab="kommunikation" class="tab_right_arrow" style="width: 180px;">@(Model.Anmeldelse != null && Model.Anmeldelse.ModtagerAnlaeg != null && Model.Anmeldelse.ModtagerAnlaeg.AnvenderJF ? "5" : "4"). Kommunikation</div>
            <div id="tab_6" data-tab="revision" class="tab_right_arrow" style="display:@(Model.Revision ? "block" : "none");">@(Model.Anmeldelse != null && Model.Anmeldelse.ModtagerAnlaeg != null && Model.Anmeldelse.ModtagerAnlaeg.AnvenderJF ? "6" : "5"). Revision</div>
        </div>

        <div id="divValidering" class="row" style="margin-left: 8px; color: red;">
            @Html.ValidationSummary(false)
            @Html.Partial("_Validering", Model)
            @*
                Det er MEGET vigtigt at alle Html.HiddenFor(m => m...) senedes med i _Validering.cshtml filen! 
                Oprindeligt var de placeret her, men de fleste blev fjernet hver gang koden var vej af serveren. 
            *@
        </div>        

        <div id="tabContents" class="tabContents">
            <div id="tabContent_1" style="margin-top: -5px;">
                @Html.Partial("_Sted", Model)
            </div>
            <div id="tabContent_2" class="disabled" style="margin-top: -5px;">
                @Html.Partial("_Jorden", Model)
            </div>
            <div id="tabContent_3" class="disabled" style="margin-top: -5px;">
                <div class="row">
                    @Html.Partial("_ModtagerOgTransportoer", Model)
                </div>
            </div>
            <div id="tabContent_4" class="disabled" style="margin-top: -5px;">
                <div class="row">
                    @Html.Partial("_Betaler", Model)
                </div>
            </div>
            <div id="tabContent_5" class="disabled" style="margin-top: -5px;">
                <div class="row">
                    @Html.Partial("_Kommunikation", Model)
                </div>
            </div>
            <div id="tabContent_6" class="disabled" style="margin-top: -5px;">
                <div class="row">
                    @if (@Model.Revision)
                    {
                        @Html.Partial("_Revision", Model)
                    }
                </div>
            </div>
        </div>
    }
</section>

