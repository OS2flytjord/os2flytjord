<section id="anmeldelseForm">
    @using (Ajax.BeginForm("Opret", "Anmeldelser",
        new AjaxOptions { HttpMethod = "POST", OnSuccess = "onFormSuccess", UpdateTargetId = "divValidering" },
        new { Id = "formOpretAnmeldelse" }))
    {
        @Html.AntiForgeryToken()
        <div class="toolbarButtons">
