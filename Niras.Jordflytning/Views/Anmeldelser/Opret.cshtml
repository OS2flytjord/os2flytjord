@using Niras.Jordflytning
@using Niras.Jordflytning.ViewModels.Anmeldelse
@using System.Configuration
@model OpretModel
@{
    ViewBag.Title = "Anmeldelse";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

@section Scripts{
    <script src='@(Model.KortApiUrl)' type='text/javascript'></script>
    <script src="~/Scripts/Map/MapSted.js" type="text/javascript"></script>

    @Scripts.Render("/bundles/proj4s")


    <script type="text/javascript">
        var visRevision = false;

        var setCommand = function(value) {
            $("#command").val(value);
        }

        $(document).ready(function() {

            //Validering af dansk datoformat
            $.validator.methods.date = function(value, element) {
                return this.optional(element) || (/^\d{1,2}[\/-]\d{1,2}[\/-]\d{4}(\s\d{2}:\d{2}(:\d{2})?)?$/.test(value) && !/Invalid|NaN/.test(new Date(value.replace("/", "-").split("-")[2], value.replace("/", "-").split("-")[1], value.replace("/", "-").split("-")[0])));
            };

            kendo.culture("da-DK");

            var winRaadgiver = Jordflytning.ui.createModalWindow("winRaadgiver", 315, 400, "Send link til rådgiver", false);
            var winJordmodtgaerAngivJordmaengdeIFJ = Jordflytning.ui.createModalWindow("winJordmodtgaerAngivJordmaengdeIFJ", 150, 400, "Angiv jordmængde", false);
            var winNyBetaler = Jordflytning.ui.createModalWindow("winNyBetaler", 450, 1000, "Opret ny betaler", false);
            var winInaktivtJordmodtageranlæg = Jordflytning.ui.createModalWindow("winInaktivtJordmodtageranlæg", 100, 300, "Inaktivt modtageanlæg", false);
            var winOpdaterforureningskategori = Jordflytning.ui.createModalWindow("winOpdaterforureningskategori", 150, 400, "Opdater forureningskategori", false);
            var winGennemse = Jordflytning.ui.createModalWindow("winGennemse", 600, 800, "Indsend anmeldelse", false);

            $("#btnInaktivtJordmodtagerAnlaeg").click(function() {
                winInaktivtJordmodtageranlæg.center();
                winInaktivtJordmodtageranlæg.open();
            });

            $("#btnBetalerNy").click(function() {
                if ($("#hflLockBetaler").val() != "True") {
                    winNyBetaler.center();
                    winNyBetaler.open();
                    $('#chkValiderbetaler').prop('checked', true);
                }
            });

            $("#btnGem").click(function() {
                $("#divProgress").show();
                $("#divValidering").hide();
                $("#divValideringListe").empty();
            });

            $("#btnRevider").click(function() {

                @if (Model.Anmeldelse != null && Model.Anmeldelse.ModtagerAnlaeg != null && Model.Anmeldelse.ModtagerAnlaeg.Aktiv && Model.Anmeldelse.ModtagerAnlaeg.Jordmodtager.Aktiv && Model.Anmeldelse.Transportoer != null && Model.Anmeldelse.Transportoer.Aktiv)
                {
                    @:$("#divProgress").show();
                    @:return true;
                }
                else if (Model.Anmeldelse != null && Model.Anmeldelse.ModtagerAnlaeg != null && (!Model.Anmeldelse.ModtagerAnlaeg.Aktiv || !Model.Anmeldelse.ModtagerAnlaeg.Jordmodtager.Aktiv))
                {
                    @:alert('Modtageanlægget eller jordmodtageren er ikke aktivt');
                    @:return false;
                }
                else if (Model.Anmeldelse != null && Model.Anmeldelse.Transportoer != null && !Model.Anmeldelse.Transportoer.Aktiv)
                {
                    @:alert('Transportøren er ikke aktiv');
                    @:return false;
                }
            });

            $("#btnGennemse").click(function(e) {
                e.preventDefault();
                $("#divProgress").show();

                // Hijack output
                setCommand('Gennemse');
                var params = $("#formOpretAnmeldelse").serialize();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Opret", "Anmeldelser")",
                    data: params,
                    dataType: "html",
                    success: function (data) {
                        $("#divProgress").hide();
                        // Hvis splitter strengen er med fra _Gennemse.cshtml filen, er det en visning af vinduet
                        var splitterId = "#previewValideringSplitter#";
                        var pvis = data.indexOf(splitterId)
                        if (pvis > -1) {
                            var parts = data.split(splitterId);
                            $("#gennemseIndhold").html(parts[0]);
                            $("#divValidering").html(parts[1]);
                            winGennemse.center();
                            winGennemse.open();
                        }
                        else {
                            // Ellers er det ren validering
                            $("#divValidering").html(data).show();
                        }
                    },
                    error: function(err) {
                        $("#divProgress").hide();
                        console.log(err.responseText);
                            alert('Bad server response');
                    }
                });
            });
            $("#btnGennemseLuk").click(function(e) {
                winGennemse.close();
            });

            $("#btnAfsend").click(function(e) {
                var c = confirm('Er du sikker på, at du vil afsende anmeldelsen?\n\nAnmeldelsen behandles automatisk af systemet. \nDer kan gå et stykke tid før du returneres til forsiden.');
                if (c) {
                    $("#divProgress").show();
                    $("#divValidering").hide();
                    $("#divValideringListe").empty();
                    $("#btnIndsend").trigger('click');
                    winGennemse.close();
                }
            });

            $("#btnRaadgiver").click(function() {
                var aid = $("#hflAnmeldelseId").val();
                if (aid != '00000000-0000-0000-0000-000000000000') {
                    winRaadgiver.center();
                    winRaadgiver.open();
                } else {
                    window.displayMessage('Anmeldelsen skal gemmes, før den kan sendes til rådgiveren.');
                }
            });

            $("#btnRaadgiverSend").click(function(e) {
                e.preventDefault();
                if ($("#emailForm").validate().form()) {
                    var raadgiverEmail = $("#txtRaadgiverEmail").val();
                    var raadgiverBesked = $("#txtRaadgiverBesked").val();
                    var aid = $("#hflAnmeldelseId").val();
                    if (raadgiverEmail != "") {
                        $.post("/Anmeldelser/SendAnmeldelseTilRaadgiver",
                            {
                                anmeldelseId: aid,
                                raadgiverEmail: raadgiverEmail,
                                raadgiverBesked: raadgiverBesked
                            },
                            function(result) {
                                if (result) {
                                    $("#txtRaadgiverEmail").val("");
                                    $("#txtRaadgiverBesked").val("");
                                    winRaadgiver.close();
                                }
                            });
                    } else {
                        alert("Email adressen skal udfyldes.");
                    }
                } else {
                    alert("Email adressen skal udfyldes.");
                }
            });


            $("#btnVisAnmeldelse").click(function(e) {
                //siden åbnes i et nyt browser vindue, så man kan se blankettetn samtidig med sagsbehandlings fanen.
                e.preventDefault();
                var aid = $("#hflAnmeldelseId").val();

                window.open("https://" + "@MvcApplication.FlytjordDomain" + "/blanketter/" + aid, "_blank");
            });

            $("#btnStedNyEjendom").click(function(e) {
                e.preventDefault();
                if ($("#hflLockSted").val() != "True") {
                    resetJordforureningOpslag();
                    $("#divEjendomAdresseEdit").show();
                    $("#divOffvejAdresseEdit").show();

                    $("#divAdresseView").hide();
                    $("#hvadvildunu").hide();

                    $("#divEjendomMapDigPolygon").hide();
                    $("#divOffVejMapDigPolygon").hide();

                    //Reset adresse opslag
                    $("#vejnavnAutoComplete").val("");

                    //Show road name lookup
                    $('#dawaAutoComplete').val('');
                    $('#divEjendomAdresseOpslagEdit').show();
                    $('#divOffvejAdresseOpslagEdit').show();

                    if ($("#drpHusnummerComplete").data("kendoDropDownList") !== undefined && $("#drpHusnummerComplete").data("kendoDropDownList") !== null) {
                        var ddl = $("#drpHusnummerComplete").data("kendoDropDownList");
                        ddl.dataSource.data({}); // clears dataSource
                        ddl.text(""); // clears visible text
                        ddl.value(""); // clears invisible value
                    }


                    $("#vejnavnOpslag").val("");

                }

            });

            $("#btnAfslut").click(function(e) {
                e.preventDefault();

                if ($('#hflLockButtonAfslut').val() == 'True') {
                } else if (confirm('Anmeldelsen inaktiveres og kan ikke benyttes længere.\n\nEr du sikker på, at du vil afslutte anmeldelsen?')) {
                    $("#divProgress").show();
                    var aid = $("#hflAnmeldelseId").val();
                    $.post("@Url.Action("AfslutAnmeldelse", "Anmeldelser")",
                        { anmeldelsesId: aid },
                        function(result) {
                            onFormSuccess();
                            window.displayMessage(result.Message);

                            if (result.Success == true) {
                                setTimeout('window.location = "../Default/Startside"', 1000);
                            }
                        });
                }
            });


            $("#btnAfslutMedAnalysedocs").click(function(e) {
                e.preventDefault();

                if ($('#hflLockButtonAfslut').val() == 'True') {
                } else {
                    $("#divProgress").show();
                    var aid = $("#hflAnmeldelseId").val();
                    $.post("@Url.Action("AfslutAnmeldelse", "Anmeldelser")",
                        { anmeldelsesId: aid },
                        function(result) {
                            onFormSuccess();
                            window.displayMessage(result.Message);

                            if (result.Success == true) {
                                setTimeout('window.location = "../Default/Startside"', 1000);
                            }
                        });
                }
            });


            $("#btnJordmodtgaerAngivJordmaengdeIFJ").click(function() {
                var aid = $("#hflAnmeldelseId").val();
                if (aid != '00000000-0000-0000-0000-000000000000') {
                    winJordmodtgaerAngivJordmaengdeIFJ.center();
                    winJordmodtgaerAngivJordmaengdeIFJ.open();
                    setTimeout(function() { $("#txtTotalMaengdeJordIkkeFJ").focus(); }, 500);
                } else {
                    window.displayMessage('Anmeldelsen er ikke gemt.');
                }
            });

            $("#btnJordmodtgaerAngivJordmaengdeIFJSend").click(function(e) {
                e.preventDefault();
                if ($("#jordmodtgaerAngivJordmaengdeIFJForm").validate().form()) {
                    var jordmaengde = $("#txtTotalMaengdeJordIkkeFJ").val();
                    var aid = $("#hflAnmeldelseId").val();
                    if (jordmaengde != "") {
                        $.post("/Anmeldelser/SendJordmodtgaerAngivJordmaengdeIFJ",
                            {
                                anmeldelseId: aid,
                                jordmaengdeTons: jordmaengde
                            },
                            function(result) {
                                if (result.Success) {
                                    $("#txtTotalMaengdeJordIkkeFJ").val("");
                                    winJordmodtgaerAngivJordmaengdeIFJ.close();
                                } else {
                                    alert(result.Message);
                                }
                            });
                    } else {
                        alert("Jordmængden skal angives");
                    }
                } else {
                    alert("Jordmængden skal angives");
                }
            });

            function SoegEksterneSystemer() {
                $("#divStedJordforureningOpslag").show();
                getJordForurening();
                $("#hvadvildunu").show();
                return false;
            }

            $("#stedTypeEjendom").click(function() {
                if ($("#hflLockSted").val() == "True") {
                    e.preventDefault();
                } else {
                    resetJordforureningOpslag();
                    $("#divEjendom").show();
                    $("#divOffentligVej").hide();
                    $("#divStedOffVejLinkTilEksternsystem").hide();
                    $("#divAndenOprindelse").hide();
                    $("#vejnavnAutoComplete").focus();
                    $("#btnStedNyEjendom").click();
                    $("#divEjendomMapDigPolygon").hide();
                    $("#divOffVejMapDigPolygon").hide();
                }
            });

            $("#stedTypeOffentligVej").click(function() {
                if ($("#hflLockSted").val() == "True") {
                    e.preventDefault();
                } else {
                    //resetJordforureningOpslag();
                    $("#divEjendom").hide();
                    $("#divOffentligVej").show();
                    $("#divStedOffVejLinkTilEksternsystem").show();


                    $("#divAndenOprindelse").hide();
                    $("#vejnavnOpslag").focus();
                    $("#btnStedNyEjendom").click();
                    $("#divEjendomMapDigPolygon").hide();
                    $("#divOffVejMapDigPolygon").hide();
                }
            });

            $("#stedTypeAndenOprindelse").click(function() {
                    if ($("#hflLockSted").val() == "True") {
                        e.preventDefault();
                    } else {
                        resetJordforureningOpslag();
                        $("#divEjendom").hide();
                        $("#divOffentligVej").hide();
                        $("#divStedOffVejLinkTilEksternsystem").hide();
                        $("#divAndenOprindelse").show();
                        $("#btnStedNyEjendom").click();

                        //Indlæs forureningskategorierne for den valgte kommune.
                        window.loadAndenOprindelseJordklassifikationerForKommune();

                    }
                }
            );

            $("div[class*='tab_right_arrow']").click(function() {
                var idx = $(this).attr("id").split("_")[1];
                $("div[id*='tab_']").attr("class", "tab_right_arrow");
                $(this).attr("class", "tab_right_arrow_active");
                var tabContentId = "tabContent_" + idx;
                $("div[id*='tabContent_']").attr("class", "tabContent disabled");
                $("#" + tabContentId).attr("class", "tabContent");

                if (idx == "1") {
                    //Toolbarbuttons skal ike være synlig på første fane
                    $("#divToolbarButtons").hide();
                } else {
                    $("#divToolbarButtons").show();
                }
            });

            $("#imgSignaturForklaringColapse").click(function() {
                $("#imgSignaturForklaringExpand").show();
                $("#imgSignaturForklaringColapse").hide();
                $("#imgSignaturForklaring").addClass("hideSignaturForklaring");
            });

            $("#imgSignaturForklaringExpand").click(function() {
                $("#imgSignaturForklaringExpand").hide();
                $("#imgSignaturForklaringColapse").show();
                $("#imgSignaturForklaring").removeClass("hideSignaturForklaring");
            });

            $("#imgMaximise").click(function() {
                //Gemmer venstre kolonne.
                $("#divStedLeft").hide();
                $("#divStedHelpMap").hide();

                $("#divStedRight").css('width', '100%');
                $("#divMapSted").css('height', '600px');

                //Signaturforklaring placering ved max kort
                $("#imgSignatur").addClass("maxMapSignatur");
                $("#imgSignaturForklaring").addClass("maxMapSignaturForklaring");
                $("#imgSignaturForklaringExpand").addClass("maxMapSignaturForklaringColapseExpand");
                $("#imgSignaturForklaringColapse").addClass("maxMapSignaturForklaringColapseExpand");


                $("#imgMaximise").toggle();
                $("#imgMinimise").toggle();
            });
            $("#imgMinimise").click(function() {
                //Viser venstre kolonne.
                $("#divStedLeft").show();
                $("#divStedHelpMap").show();

                $("#divStedRight").css('width', '500px');
                $("#divMapSted").css('height', '410px');

                //Signaturforklaring placering ved min kort
                $("#imgSignatur").removeClass("maxMapSignatur");
                $("#imgSignaturForklaring").removeClass("maxMapSignaturForklaring");
                $("#imgSignaturForklaringExpand").removeClass("maxMapSignaturForklaringColapseExpand");
                $("#imgSignaturForklaringColapse").removeClass("maxMapSignaturForklaringColapseExpand");


                $("#imgMaximise").toggle();
                $("#imgMinimise").toggle();
            });

            $("#rblJordproeverJa").click(function() {
                $("#divJordProever").show();
                $("#divJordAntalProever").show();
                $("#divJordIntaktJord").show();
                $("#chkIntaktJord").prop('checked', false);

                //var forureningOpslagJordklassifikationTypeId = $("#hflForureningOpslagJordklassifikationTypeId").val();
                ////Sætter forureningskategorien til det den var før.
                ////Hvis der ikke er lavet et opslag i de eksterne services kan den selvfølgelig ikke sættes og det skal den heller ikke.
                //$(".jordklassifikationTypeRadiolist").each(function() {
                //  if ($(this).val() == forureningOpslagJordklassifikationTypeId) {
                //    $(this).prop('checked', true);
                //  } else {
                //    $(this).removeAttr('checked');
                //  }
                //});
            });

            $("#rblJordproeverNej").click(function() {
                $("#divJordProever").hide();
                $("#divJordAntalProever").hide();
                $("#divJordIntaktJord").show();
            });

            $("#rbtAffaldNej").click(function() {
                var dropdownlist = $("#drpAffaldType").data("kendoDropDownList");
                dropdownlist.text("");
                dropdownlist.enable(false);
            });

            $("#rbtAffaldJa").click(function() {
                var dropdownlist = $("#drpAffaldType").data("kendoDropDownList");
                dropdownlist.enable();
            });

            $("#txtAntalProever").bind("change", window.beregnAntalProeverPrJordmaengde);
            window.beregnAntalProeverPrJordmaengde();


            $("#rbtAffaldJa").click(function() {
                $("#divAffaldstype").show();
                window.popModtagerAnlaeg();
            });

            $("#rbtAffaldNej").click(function() {
                $("#divAffaldstype").hide();
                window.popModtagerAnlaeg();
            });

            $("#rbtAlm").click(function() {
                $("#txtAkutBaggrund").val("");
                $("#txtAkutBaggrund").attr("readonly", true);
                $("#divJordhaandteringsplan").hide();
            });

            $("#rbtAkut").click(function() {
                $("#txtAkutBaggrund").removeAttr("readonly");
                $("#divJordhaandteringsplan").hide();
            });

            $("#rbtStraks").click(function() {
                $("#txtAkutBaggrund").val("");
                $("#txtAkutBaggrund").attr("readonly", true);
                $("#divJordhaandteringsplan").show();
            });

            $('#txtJordBemaerkning').change(function() {
                //Bemærkningsfeltet skal også vises på kommunikationsfanen
                $("#txtKommunikationJordBemaerkning").val($('#txtJordBemaerkning').val());
            });

            $('#txtJordBemaerkning_Revision').change(function() {
                //Bemærkningsfeltet skal også vises på kommunikationsfanen
                $("#txtKommunikationJordBemaerkning_Revision").val($('#txtJordBemaerkning_Revision').val());
            });

            //Modtager Transportør
            $("#chkModtagerAnlaegAnvenderJf").change(function() {
                window.popModtagerAnlaeg();
            });

            //Betaler
            $("#btnBetalerSoeg").click(function() {
                if ($("#hflLockBetaler").val() != "True") {
                    $("#GridBetalere").data("kendoGrid").dataSource.read();
                }
            });

            $("#betalerAnmelder").click(function() {
                $("#divBetalerSoeg").hide();
            });

            $("#betalerTransportoer").click(function() {
                $("#divBetalerSoeg").hide();
            });

            $("#betalerAnden").click(function() {
                window.clearSelectedBetaler();
                $("#divBetalerSoeg").show();
                $("#txtBetalerSoeg").focus();
            });

            $("#btnBetalerNyOpret").click(function() {
                $("#winNyBetaler").data("kendoWindow").close();
                $('#chkValiderbetaler').prop('checked', false);
            });

            $("#txtBetalerSoeg").keypress(function(e) {
                if (e.keyCode == '13') {
                    e.preventDefault();
                    $("#btnBetalerSoeg").click();
                }
            });

            $("#btnNyBetaler").click(function(e) {
                $("#divNyBetalerStatus").html("");
                e.preventDefault();
                if ($("#nyBetalerForm").validate().form()) {
                    var email = $("#txtNyBetalerEmail").val();
                    if (email != "") {
                        //$.post("/Anmeldelser/OpretBetaler", { brugernavn: email },
                        $.post("/Anmeldelser/OpretBetaler",
                            $('#nyBetalerForm').serialize(),
                            function(result) {
                                if (result) {
                                    if (result != '00000000-0000-0000-0000-000000000000') {
                                        $("#txtNyBetalerEmail").val("");
                                        winNyBetaler.close();
                                        $('#chkValiderbetaler').prop('checked', false);
                                        window.setAndenBetaler(result);
                                    } else {
                                        $("#divNyBetalerStatus").html("Person kunne ikke oprettes! <br/>Kontroller om personen allerede findes i systemet.");
                                    }
                                }
                            });
                    } else {
                        alert("Email adressen skal udfyldes.");
                    }
                } else {
                    alert("Email adressen skal udfyldes.");
                }
            });


            //TOOLTIPS
            $("[data-tooltip]").each(function() {
                $(this).kendoTooltip({
                    content: $(this).attr("data-tooltip"),
                    position: "top",
                });
            });

            //Lås brugerfladen
            lockBrugerFlade();

            //Revision
            if ($("#hflRevision").val() == "True") {
                var valg = confirm('Denne anmeldelse har en revision.\n' +
                    'Ved revision af en anmeldelse er det kun jordmængde, kørselsperiode, transportør og diverse bemærkninger, der kan ændres.\n\n' +
                    'Imens den reviderede anmeldelse behandles, kan den oprindelige anmeldelse anvendes, såfremt den er aktiv.\n' +
                    'Når den reviderede anmeldelse godkendes, flettes oplysningerne fra den oprindelige anmeldelse og den reviderede anmeldelse sammen.\n\n' +
                    'Vil du gå til Revision fanen ?');
                if (valg) {
                    visRevision = true;
                }
            }


            setTimeout('popFileGrid();popHistoriskDokumentationGrid();', 3000);

            //Kort - Resten af load er ikke afhængig af kortinfos hastighed
            setTimeout('mapInitSted("@(Model.KortSite)","@(Model.KortPageSted)")', 10);

            //KOMMUNIKATION
            setTimeout('popInteressanter();', 3000);

            //Indlæs Transportører og Modtageranlæg
            //Hent data på transportør og modtager siden.
            setTimeout('popModtagerAnlaeg()', 2000);
            setTimeout('popTransportoer()', 2500);


            setFirmaGroupDisplay();
            $("#checkboxFirma").click(function() {
                setFirmaGroupDisplay();
            });


            if ('@Model.OpdaterJordforureningsKategori' == 'True') {

                var empty = '@Guid.Empty';
                var oprindelig = $("#hflJordKlassifikationType").val();
                var forureningOpslag = $("#hflForureningOpslagJordklassifikationTypeId").val();

                var skip = false;
                if ($("#hflRevision").val() == "True" && oprindelig != empty) {
                    skip = true;
                }

                if ((oprindelig == empty || forureningOpslag == empty) && !skip) {
                    SoegEksterneSystemer();
                    return;
                }

                //Henter forureningskategorierne for kommunen. getJordForurening() kaldes efter der er blevet lavet et adresse eller vej opslag.
                $.post("@Url.Action("GetJordKlassifikationerForKommune", "Anmeldelser")",
                    $("#formOpretAnmeldelse").serialize(),
                    function(resultJordKlassifikation) {
                        if (resultJordKlassifikation) {

                            //Laver opslag i eksterne datakilder for at finde jordforureningen
                            $.post("@Url.Action("GetJordForurening", "Anmeldelser")",
                                $("#formOpretAnmeldelse").serialize(),
                                function(result) {
                                    if (result) {
                                        oprindelig = $("#hflJordKlassifikationType").val();
                                        var nye = $("#hflForureningOpslagJordklassifikationTypeId").val();
                                        var message = '';

                                        //// MAKE HTML STRING JQuery friendly!
                                        if ($("#hflRevision").val() == 'True') {
                                            var resultAsHTML = document.createElement('div');
                                            resultAsHTML.innerHTML = result;

                                            nye = $(resultAsHTML).find("#hflForureningOpslagJordklassifikationTypeId").val();
                                        }

                                        if (oprindelig == empty && nye != empty) {
                                            message = 'Det oprindelige opslag i miljødatabasen fejlede. Ønsker du at opdaterer den valgte forureningskategori?';
                                        } else if (oprindelig != empty && nye == empty) {
                                            message = 'Kontrollen af den valgte forureningskategori fejlede, og den tideligere valgte bibeholdes. Ønsker du at prøve igen?';
                                        } else if (oprindelig == empty && nye == empty) {
                                            message = 'Det automatiske forureningsopslag mislykkedes. Ønsker du at prøve igen?';
                                        } else if (oprindelig != nye) {
                                            message = 'Den tidligere valgte forureningskategori svarer ikke til kategorien i miljødatabasen. Vil du ændre den oprindelige forureningskategori?';
                                        }

                                        if (message != '') {
                                            $('#opdaterJordforureningsKategoriMessage').text(message);
                                            winOpdaterforureningskategori.open();
                                        }
                                    }
                                });
                        }
                    });
            }
            $("#btnOpdaterJordforureningsKategoriJa").click(function() {
                winOpdaterforureningskategori.close();
                SoegEksterneSystemer();
            });
            $("#btnOpdaterJordforureningsKategoriNej").click(function() {
                winOpdaterforureningskategori.close();
            });

        });

        function setFirmaGroupDisplay() {
            var firma = document.getElementById('checkboxFirma');
            if (firma.checked) {
                $("#firmaGroup").show();
            } else {
                $("#firmaGroup").hide();
            }
        }

        function onFormSuccess() {
            $("#divProgress").hide();
            $("#divValidering").show();
            $("btnRaadgiver").removeAttr('disabled'); //Når anmeldelsen er gemt, må der gerne sendes et link til rådgiveren
            $("btnJordmodtgaerAngivJordmaengdeIFJ").removeAttr('disabled'); //Når anmeldelsen er gemt kan der angives jordmængde
        }

        function lockBrugerFlade() {
            //Sted
            if ($("#hflLockSted").val() == "True") {
                $("#tabContent_1 :input").attr("readonly", true);
                $('#tabContent_1 :radio:not(:checked)').attr('disabled', true);

            }
            //Jorden
            if ($("#hflLockJorden").val() == "True") {
                $("#tabContent_2 :input").attr("readonly", true);
                $('#tabContent_2 :radio:not(:checked)').attr('disabled', true);
                $('#tabContent_2 :radio:not(:checked)').attr('disabled', true);
                $('#tabContent_2 :radio:not(:checked)').attr('disabled', true);
                $('#tabContent_2 :radio:not(:checked)').attr('disabled', true);
                //Disabler radiobuttons og checkbuttons
                var deactivatorJord = function(event) { event.preventDefault(); };
                $('tabContent_2 :radio, :checkbox').click(deactivatorJord);
            }
            //Modtage
            if ($("#hflLockModtagerTransportoer").val() == "True") {
                $("#tabContent_3 :input").attr("readonly", true);
                $('#tabContent_3 :radio:not(:checked)').attr('disabled', true);

            }
            //Betaler
            if ($("#hflLockBetaler").val() == "True") {
                $("#tabContent_4 :input").attr("readonly", true);
                $('#tabContent_4 :radio:not(:checked)').attr('disabled', true);
            }
            //Kommunikation
            if ($("#hflLockKommunikation").val() == "True") {
                $("#tabContent_5 :input").attr("readonly", true);
                $('#tabContent_5 :radio:not(:checked)').attr('disabled', true);
            }

            //Revision - //Ved revision af en anmeldelse er det kun jordmængde, kørselsperiode og transportør og Link til godkendt anmeldelse der må kunne ændres. Derfor gør jeg det på denne måde.
            if ($("#hflRevision").val() == "True") {
                $("#drpDocType").removeAttr("readonly");
                /*
                $("#txtForventetJordmaengdeTon").removeAttr("readonly"); //Forventet jordmængde
                $("#datStart").removeAttr("readonly"); //Kørselsperiode start
                $("#datSlut").removeAttr("readonly"); //Kørselsperiode slut
                //$("#btnStedSoegEksterneSystemer").removeAttr("readonly"); //Hent forureningsstatus i eksterne systemer.
                $("#txtLinkTilGodkendtAnmeldelse").removeAttr("readonly"); //Link til godkendt anmeldelse

                //Transportør
                $("#ddlTransportoerFiltreringMetode").removeAttr("readonly");

                //Note: Jordklassifikationen låses op på _jordjordopslag viewet (eller rettet sagt den låses ikke)
                */

                //Vedhæft dokumentation
                $("#btnShowWinFileUpload").removeAttr("readonly");
                $("#drpDocType").removeAttr("readonly");
                $("#datDocDate").removeAttr("readonly");
                $("#files").removeAttr("readonly");

                /*
                // Jorden
                $("#Anmeldelse_Jord_TidligereErhvervsaktivitet").removeAttr("readonly");
                $("#Anmeldelse_Jord_JordarbejdeBeskrivelse").removeAttr("readonly");
                $("#txtJordBemaerkning").removeAttr("readonly");

                // Kommunikation
                $("#txtSagsbehandlingBemaerkningTilKommunen").removeAttr("readonly");
                $("#txtSagsbehandlingBemaerkningTilJordmodtager").removeAttr("readonly");
                $("#txtInternSagsnummer").removeAttr("readonly");
                */
            }

        }

        function resetJordforureningOpslag() {
            $("#hflJordKlassifikationType").val(""); //den valgt jordklassifikation

            $("#divStedJordforureningOpslag").empty();
            $("#btnKvittering").hide();
            $("#hvadvildunu").hide();
            $("#btnTilJorden").hide();
            $("#btnTilModtager").hide();

            $("#labelResultatJord").empty();
            $("#divResultat").empty();
            $("#labelResultatJord").empty();
        }

        function GetJordKlassifikationerForKommune() {
            //Henter forureningskategorierne for kommunen.
            $.post("@Url.Action("GetJordKlassifikationerForKommune", "Anmeldelser")",
                $("#formOpretAnmeldelse").serialize(),
                function(resultJordKlassifikation) {
                    if (resultJordKlassifikation) {
                        var jordKlassifiktionId = '#divJordKlassifiktion';
                        $(jordKlassifiktionId).html(resultJordKlassifikation); //Erstatter alt inde for div'en med det partial view som man ved GetJordForurening

                        $("#rblJordKlassifikationType2").prop("checked", "checked");
                        $("#hflJordKlassifikationType").val($("#rblJordKlassifikationType2").val());
                    }
                });
        }
    </script>
}

