            <input style="width:125px;" type="button" value="Send til rådgiver" id="btnRaadgiver" class="toolbarButton"
                   @{ if ((Model.Anmeldelse != null && Model.Anmeldelse.Id != Guid.Empty) && !Model.LockButtonSendTilRaadgiver) { <text></text>  } else { <text> disabled="disabled" </text>  } } />

            @*<input style="width:125px;" id="btnAfsend" name="execute" onclick="setCommand(this.value)" type="submit" value="Indsend" style="background-color: #BDBDBD !Important" @{ if (Model.LockButtonIndsend) { <text> class="toolbarButton btnDisabled" disabled="disabled" data-tooltip="Anmeldelsen kan ikke indsendes" </text>     } else { <text> class="toolbarButton" </text>     } } />*@
            @* Se JavaScript til gennemsyn for at forstå hvad der sker i dette hijack af indsend *@
            <input style="width:125px;" id="btnGennemse" name="execute" onclick="setCommand('')" type="button" value="Indsend" style="background-color: #BDBDBD !Important" @{ if (Model.LockButtonIndsend) { <text> class="toolbarButton btnDisabled" disabled="disabled" data-tooltip="Anmeldelsen kan ikke indsendes" </text>  } else { <text> class="toolbarButton" </text>  } } />
            <input type="hidden" name="command" id="command" value="" />
            <input type="submit" id="btnIndsend" name="execute" onclick="setCommand(this.value)" value="Indsend" style="display: none;" />

            @if (!Model.LockButtonVisAnmeldelse)
            {
                <input type="button" value="Vis anmeldelse" class="toolbarButton" id="btnVisAnmeldelse" />
            }


            @if (!Model.LockButtonReviderAnmeldelse && !Model.JordmodtagerAnlaegErInaktiv)
            {

                <input id="btnRevider" name="execute" onclick="setCommand(this.value)" type="submit" value="Revider anmeldelse" class="toolbarButton" />


                <a id="info-revider" style="float: left; height: 16px; width: 16px; border: 0; margin-top: 4px; margin-left: -7px; margin-right: 10px; cursor: pointer;" href="https://www.dropbox.com/s/5g0w77p2laxmrdo/Revision%20af%20godkendt%20anmeldelse%2C%20skriftlig%20vejledning.docx" target="_blank">
                    <img src="/Content/Icons/info_button.png" style="height: 16px; width: 16px; border: 0px; margin-right: 10px;" />
                </a>
            }
            else if (!Model.LockButtonReviderAnmeldelse && Model.JordmodtagerAnlaegErInaktiv)
            {
                <input id="btnInaktivtJordmodtagerAnlaeg" type="button" value="Revider anmeldelse" class="toolbarButton" />

                <a id="info-revider" style="float: left; height: 16px; width: 16px; border: 0; margin-top: 4px; margin-left: -7px; margin-right: 10px; cursor: pointer;" href="https://www.dropbox.com/s/5g0w77p2laxmrdo/Revision%20af%20godkendt%20anmeldelse%2C%20skriftlig%20vejledning.docx" target="_blank">
                    <img src="/Content/Icons/info_button.png" style="height: 16px; width: 16px; border: 0; margin-right: 10px;" />
                </a>

                //Jira JF-445
                //Tilføj attributten data-tooltip med beskeden om at revision ikke kan
                //Vis knappen disabled men med en data-tooltio attribut med besked om hvorfor anmeldelsen ikke kan revideres.
            }

            @if (!Model.LockButtonAfslut)
            {
                <input id="btnAfslut" type="button" value="Afslut anmeldelse" class="toolbarButton" style="display:none; visibility:hidden;" />
            }

            @if (!Model.LockButtonAfslut)
            {
