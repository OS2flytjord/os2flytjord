                       @{ if (Model.Anmeldelse != null && Model.Anmeldelse.Id != Guid.Empty) { <text></text>  } else { <text> disabled="disabled" </text>  } } />
            }
            @if (Model.Anmeldelse != null && Model.Anmeldelse.Nummer != 0)
            {
