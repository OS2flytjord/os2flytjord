@model Niras.Jordflytning.ViewModels.Backend.SagsbehandlingModel

@{
    ViewBag.Title = "Blanket";
    Layout = "~/Views/Shared/_LayoutBlanket.cshtml";
}
<script type="text/javascript">
    //Wrap it within $(document).ready() to invoke the function after DOM loads.

    $(document).ready(function () {
        //https://github.com/jeromeetienne/jquery-qrcode


        var lbnr = "1" + $("#hflNummer").val();
        /*var pad = "0000000000";
        (lbnr + pad).slice(-pad.length);*/

        $('#qrcodeholder').qrcode({
            text: lbnr,
            //render: "canvas",  // 'canvas' or 'table'. Default value is 'canvas'
            render: "table",  // 'canvas' or 'table'. Default value is 'canvas'
            background: "#ffffff",
            foreground: "#000000",
            width: 100,
            height: 100
        });

    });


</script>

@Html.HiddenFor(m => m.AnmeldelseModel.Anmeldelse.Nummer, new { Id = "hflNummer" })
