                    {
                        <td style="font-size: 14px; font-weight: bold;">Anmeldelsen er afsluttet</td>
                    }
                    else if (Model.AnmeldelseModel.Anmeldelse != null && Model.AnmeldelseModel.AnmeldelseErAktiv)
                    {
                    <td style="font-size: 14px; font-weight: bold;">Anmeldelsen er godkendt</td>
                    }
                    else if (Model.BlanketAnmeldelseAfvist != "")
                    {
                    <td style="font-size: 14px; font-weight: bold;">Anmeldelsen er afvist</td>
                    }
                    else
                    {
                    <td style="font-size: 14px; font-weight: bold;">Anmeldt ikke anvist</td>
                    }
