                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.AnmeldelseModel.Anmeldelse.Jord.TidligereErhvervsaktivitet) && Model.AnmeldelseModel.Anmeldelse.Kommune.Navn == "Syddjurs")
                {
                    <tr>
                        <td class="rightFirstTd">Tidligere erhvervsaktivitet:</td>
                        <td>@Html.DisplayFor(m => m.AnmeldelseModel.Anmeldelse.Jord.TidligereErhvervsaktivitet)</td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.AnmeldelseModel.Anmeldelse.Jord.JordarbejdeBeskrivelse) && Model.AnmeldelseModel.Anmeldelse.Kommune.Navn == "Syddjurs")
                {
                    <tr>
                        <td class="rightFirstTd">
                            Beskrivelse af jordarbejdet:
                        </td>
                        <td>@Html.DisplayFor(m => m.AnmeldelseModel.Anmeldelse.Jord.JordarbejdeBeskrivelse)</td>
                    </tr>
                }
            </table>
        </td>

    </tr>
    <tr>
        <td colspan="2">
            <div class="hr"></div>
        </td>
    </tr>
        @if (Model != null && Model.BlanketAnmeldelseAfvist == "")
        {
        <tr>
            <td class="leftcell">VIGTIGT!</td>
            <td class="rigthcell">
                <table style="width: 100%">
                    <tr>
                        <td>
                            Denne godkendte anmeldelse skal medbringes af chaufføren og fremvises ved aflevering af jorden og skal mod forlangende forevises miljømyndighederne.

                        </td>


                    </tr>
                </table>
            </td>

        </tr>
  
        <tr>
            <td colspan="2">
                <div class="hr"></div>
            </td>
        </tr>
        }
        <tr>
            <td colspan="2" style="height: 1mm"></td>
        </tr>
        <tr>
            <td colspan="2">
                @Html.Raw(Model.BlanketFooter)

            </td>
        </tr>
    </table>
</div>
