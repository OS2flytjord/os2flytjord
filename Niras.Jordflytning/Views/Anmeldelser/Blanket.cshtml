                                                }
                                            </tr>


                                            <tr>
                                                <td>Sagsbehandler:</td>
                                                <td>
                                                    @Html.DisplayFor(m => m.BlanketSagsbehandler)
                                                </td>
                                            </tr>



                                        </table>
                                    </td>
                                </tr>

                            </table>
                        </td>


                    </tr>
                </table>

            </td>
