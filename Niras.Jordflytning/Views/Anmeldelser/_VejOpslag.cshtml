@{
    string style = "width:474px;";

    if (ViewData["Style"] != null)
    {
        style = (string)ViewData["Style"];
    }
}

<input id="vejnavnOpslag"
       class="classiclook_kendo_workaround"
       style="@style" />

<script>
    $(function () {
        var autoComplete = $("#vejnavnOpslag").kendoAutoComplete({
            dataTextField: "displayname",
            minLength: 1,
            placeholder: "Indtast vejnavn",
            filter: "contains",

            select: function (e) {
                var item = this.dataItem(e.item.index());

                if (!item) {
                    return;
                }

                // First stage:
                // Only a road name has been selected.
                // Search again for the exact road name so postcode variants appear.
                if (item.roadOnly) {
                    e.preventDefault();

                    var vejnavn = item.vejnavn + " ";

                    this.value(vejnavn);

                    setTimeout(function () {
                        autoComplete.search(vejnavn);
                    }, 100);

                    return;
                }

                // Second stage:
                // A specific road + postcode has been selected.
                if (item.needsLookup) {
                    // Built from house numbers (road exists in only one postcode):
                    // look up a house number first to find the road id.
                    lookupVejFromHusnummer(item);
                    return;
                }

                loadVej(item, item.id);
            },

            dataSource: {
                serverFiltering: true,

                transport: {
                    read: function (options) {
                        var address = $("#vejnavnOpslag").val();

                        $.ajax({
                            url: "https://adressevaelger.dk/husnumre/soeg",
                            dataType: "json",
                            data: {
                                tekst: address,
                                token: "adressevaelger123"
                            },

                            success: function (response) {
                                handleResults(response.fund || [], address, options, true);
                            },

                            error: function (
                                xhr,
                                status,
                                errorThrown
                            ) {
                                options.error(xhr);

                                fejlikommunikationVejnavne(
                                    xhr,
                                    status,
                                    errorThrown
                                );
                            }
                        });
                    }
                }
            }
        }).data("kendoAutoComplete");
    });

    // Builds the dropdown items from an API result.
    // allowFallback: if the API skipped the road level and returned house numbers,
    // search once more by road name to get the postcode variants.
    function handleResults(results, address, options, allowFallback) {
        // Road names without postcode (broad search, type "vejnavn")
        // and road + postcode (narrow search, type "navngivenvejpostnummer")
        var roadItems = results.filter(function (item) {
            return item &&
                (item.type === "vejnavn" ||
                    item.type === "navngivenvejpostnummer");
        });

        var navngiven = roadItems.filter(function (item) {
            return item.type === "navngivenvejpostnummer";
        });

        var input = (address || "")
            .trim()
            .toLowerCase();

        // If the entered text exactly matches a road name,
        // show all postcode variants for that road.
        var exactMatches = navngiven.filter(function (item) {
            return getVejnavn(item).toLowerCase() === input;
        });

        if (exactMatches.length > 0) {
            options.success(toPostnrItems(exactMatches));
            return;
        }

        var vejnavne = distinctVejnavne(roadItems);

        // Only one road exists in the result:
        // show all postcode variants directly, if we have them.
        if (vejnavne.length === 1) {
            var single = toPostnrItems(navngiven.filter(function (f) {
                return getVejnavn(f) === vejnavne[0];
            }));

            if (single.length > 0) {
                options.success(single);
                return;
            }
            // Otherwise fall through and show the road name as roadOnly
        }

        // Multiple roads (or only "vejnavn" items):
        // only show each road name once.
        if (vejnavne.length > 0) {
            options.success(toRoadOnlyItems(vejnavne));
            return;
        }

        // The API skipped the road level and returned house numbers directly
        // (e.g. "Geranievej "). Get the road names from the house numbers.
        var husnumre = results.filter(function (item) {
            return item && item.type === "husnummer";
        });

        var husVejnavne = distinctVejnavne(husnumre);

        // One road: search by road name to get all postcode variants
        if (husVejnavne.length === 1 && allowFallback) {
            searchByVejnavn(husVejnavne[0], options);
            return;
        }

        // Still only house numbers for one road: the road exists in a single postcode.
        // Build the road + postcode item(s) from the house numbers.
        if (husVejnavne.length === 1) {
            options.success(toHusnummerRoadItems(husnumre));
            return;
        }

        // Several roads: let the user pick the road first
        if (husVejnavne.length > 1) {
            options.success(toRoadOnlyItems(husVejnavne));
            return;
        }

        // No matching road results
        options.success([]);
    }

    // Fallback search using the vejnavn parameter instead of free text,
    // which returns the road + postcode variants instead of house numbers.
    function searchByVejnavn(vejnavn, options) {
        $.ajax({
            url: "https://adressevaelger.dk/husnumre/soeg",
            dataType: "json",
            data: {
                vejnavn: vejnavn,
                token: "adressevaelger123"
            },
            success: function (response) {
                // allowFallback = false, so this can never loop
                handleResults(response.fund || [], vejnavn, options, false);
            },
            error: function (xhr, status, errorThrown) {
                options.error(xhr);

                fejlikommunikationVejnavne(
                    xhr,
                    status,
                    errorThrown
                );
            }
        });
    }

    // Builds one road + postcode item per postcode from house number results.
    // titel looks like "Gerbrandsvej 2, 2300 København S"
    // or "Geranievej 1, Mejrup, 7500 Holstebro".
    function toHusnummerRoadItems(husnumre) {
        var seen = {};
        var items = [];

        husnumre.forEach(function (h) {
            var titel = h.titel || "";
            var commaIndex = titel.indexOf(",");
            var rest = commaIndex >= 0 ? titel.substring(commaIndex + 1).trim() : "";

            var lastPart = rest.split(",").pop().trim();
            var match = lastPart.match(/^(\d{4})\s+(.+)$/);
            var postnr = match ? match[1] : "";
            var postdistrikt = match ? match[2] : "";

            var key = getVejnavn(h) + "|" + postnr;

            if (seen[key]) {
                return;
            }

            seen[key] = true;

            items.push({
                displayname: getVejnavn(h) + (rest ? ", " + rest : ""),
                id: key,
                husnummerId: h.id,
                needsLookup: true,
                postnr: postnr,
                postdistrikt: postdistrikt,
                type: "husnummervej",
                roadOnly: false,
                vejnavn: getVejnavn(h)
            });
        });

        return items;
    }

// Looks up a house number by id to find the id of its road.
function lookupVejFromHusnummer(item) {
        $.ajax({
            url: "https://adressevaelger.dk/husnumre/" + encodeURIComponent(item.husnummerId),
            dataType: "json",
            data: {
                token: "adressevaelger123"
            },
            success: function (detail) {
                var lokalId = getVejLokalIdFromHusnummer(detail);

                if (!lokalId) {
                    console.warn("Could not find a road id in the husnummer lookup", detail);
                    alert("Vejen kunne ikke findes. Prøv igen eller vælg en anden vej.");
                    return;
                }

                loadVej(item, lokalId);
            },
            error: function (xhr, status, errorThrown) {
                fejlikommunikationVejnavne(
                    xhr,
                    status,
                    errorThrown
                );
            }
        });
    }

    // Gets the road + postcode id (navngivenvejpostnummer) from a /husnumre/{id} lookup.
    // This is the same kind of id as item.id on navngivenvejpostnummer search results,
    // which is what AdresseController.SearchAllVeje expects as lokalId.
    function getVejLokalIdFromHusnummer(detail) {
        var husnummer = detail && detail.husnummer;

        return (husnummer &&
            husnummer.navngivenvejpostnummer &&
            husnummer.navngivenvejpostnummer.id_lokalid) ||
            null;
    }

    // Sends the road id to AdresseController.SearchAllVeje and shows the road on the map.
    function loadVej(item, lokalId) {
        $.ajax({
            url: "/Adresse/SearchAllVeje",
            type: "GET",
            dataType: "json",
            data: {
                lokalId: lokalId
            },
            success: function (data) {
                if (!data || !data.wkt) {
                    return;
                }

                $("#divAdresseView").show();
                $("#divOffVejMapDigPolygon").show();

                $("#hflAdresse").val(item.vejnavn);
                $("#txtAdresse").val(item.vejnavn);

                $("#hflPostDistrikt").val(item.postdistrikt);
                $("#hflPostnummer").val(item.postnr);
                $("#txtPostDistrikt").val(item.postdistrikt);
                $("#txtPostnummer").val(item.postnr);
                $("#txtKommune").val(getKommuneNavn(data.kommuneKode));

                $("#hflOprindelsesstedWkt").val(data.wkt);
                mapStedNavigateToMultiLineStringWkt(data.wkt);
            },
            error: function (xhr, status, errorThrown) {
                fejlikommunikationVejnavne(
                    xhr,
                    status,
                    errorThrown
                );
            }
        });
    }

    // Distinct road names, in the order they appear
    function distinctVejnavne(list) {
        var vejnavne = [];
        var vejSet = {};

        list.forEach(function (item) {
            var vejnavn = getVejnavn(item);

            if (vejnavn && !vejSet[vejnavn]) {
                vejSet[vejnavn] = true;
                vejnavne.push(vejnavn);
            }
        });

        return vejnavne;
    }

    // Road names as first-stage items (selecting one searches again)
    function toRoadOnlyItems(vejnavne) {
        return vejnavne.map(function (vejnavn) {
            return {
                displayname: vejnavn,
                id: vejnavn,
                roadOnly: true,
                vejnavn: vejnavn
            };
        });
    }

    // Road name from an API item.
    // "vejnavn" items may only have titel, so fall back to that.
    function getVejnavn(item) {
        return (item.vejnavn || item.titel || "").trim();
    }

    // Converts navngivenvejpostnummer items to autocomplete items (one per road + postcode)
    function toPostnrItems(list) {
        var seen = {};
        var items = [];

        list.forEach(function (f) {
            var key = (f.postnr || "") + "|" + (f.id || "");

            if (seen[key]) {
                return;
            }

            seen[key] = true;

            items.push({
                displayname: f.titel || (f.vejnavn + " " + f.postnr),
                id: f.id || key,
                postnr: f.postnr,
                postdistrikt: f.postdistrikt,
                type: f.type,
                roadOnly: false,
                vejnavn: f.vejnavn
            });
        });

        return items;
    }

    function fejlikommunikationVejnavne(
        xhr,
        status,
        errorThrown
    ) {
        alert(
            "Fejl i adresseopslaget: Status: " +
            status +
            ", errorThrown: " +
            errorThrown
        );
    }

