@{
    string style = "width:474px;";

    if (ViewData["Style"] != null)
    {
        style = (string)ViewData["Style"];
    }
}

<input
    id="vejnavnOpslag"
    class="classiclook_kendo_workaround"
    style="@style"
/>

<script>
    $(function () {
        var autoComplete = $("#vejnavnOpslag").kendoAutoComplete({
            dataTextField: "displayname",
            minLength: 1,
            placeholder: "Indtast vejnavn",
            filter: "contains",

            select: function (e) {
                var item = this.dataItem(e.item.index());

                if (!item) {
                    return;
                }

                // First stage:
                // Only a road name has been selected.
                // Search again for the exact road name so postcode variants appear.
                if (item.roadOnly) {
                    e.preventDefault();

                    var vejnavn = item.vejnavn + " ";

                    this.value(vejnavn);

                    setTimeout(function () {
                        autoComplete.search(vejnavn);
                    }, 100);

                    return;
                }

                // Second stage:
                // A specific road + postcode has been selected.
                // Send its ID to AdresseController.SearchAllVeje.
                $.ajax({
                    url: "/Adresse/SearchAllVeje",
                    type: "GET",
                    dataType: "json",
                    data: {
                        lokalId: item.id
                    },
                    success: function (data) {
                        if (!data || !data.wkt) {
                            return;
                        }

                        $("#divAdresseView").show();
                        $("#divOffVejMapDigPolygon").show();

                        $("#hflAdresse").val(item.vejnavn);
                        $("#txtAdresse").val(item.vejnavn);

                        $("#hflPostDistrikt").val(item.postdistrikt);
                        $("#hflPostnummer").val(item.postnr);
                        $("#txtPostDistrikt").val(item.postdistrikt);
                        $("#txtPostnummer").val(item.postnr);
                        $("#txtKommune").val(getKommuneNavn(data.kommuneKode));

                        $("#hflOprindelsesstedWkt").val(data.wkt);
                        mapStedNavigateToMultiLineStringWkt(data.wkt)
                       
                    },
                    error: function (xhr, status, errorThrown) {
                        fejlikommunikationVejnavne(
                            xhr,
                            status,
                            errorThrown
                        );
                    }
                });
            },

            dataSource: {
                serverFiltering: true,

                transport: {
                    read: function (options) {
                        var address = $("#vejnavnOpslag").val();

                        $.ajax({
                            url: "https://adressevaelger.dk/husnumre/soeg",
                            dataType: "json",
                            data: {
                                tekst: address,
                                token: "adressevaelger123"
                            },

                            success: function (response) {
                                var results = response.fund || [];

                                // Only use navngivenvejpostnummer items
                                var navngiven = results.filter(function (item) {
                                    return item &&
                                        item.type === "navngivenvejpostnummer";
                                });

                                var input = (address || "")
                                    .trim()
                                    .toLowerCase();

                                // If the entered text exactly matches a road name,
                                // show all postcode variants for that road.
                                var exactMatches = navngiven.filter(function (item) {
                                    return (item.vejnavn || "")
                                        .trim()
                                        .toLowerCase() === input;
                                });

                                if (exactMatches.length > 0) {
                                    var seen = {};
                                    var items = [];

                                    exactMatches.forEach(function (f) {
                                        var key =
                                            (f.postnr || "") +
                                            "|" +
                                            (f.id || "");

                                        if (seen[key]) {
                                            return;
                                        }

                                        seen[key] = true;

                                        items.push({
                                            displayname:
                                                f.titel ||
                                                (f.vejnavn + " " + f.postnr),

                                            id: f.id || key,
                                            postnr: f.postnr,
                                            postdistrikt: f.postdistrikt,
                                            type: f.type,
                                            roadOnly: false,
                                            vejnavn: f.vejnavn
                                        });
                                    });

                                    options.success(items);
                                    return;
                                }

                                // Find all distinct road names
                                var vejnavne = [];
                                var vejSet = {};

                                navngiven.forEach(function (item) {
                                    var vejnavn = item.vejnavn || "";

                                    if (
                                        vejnavn &&
                                        !vejSet[vejnavn]
                                    ) {
                                        vejSet[vejnavn] = true;
                                        vejnavne.push(vejnavn);
                                    }
                                });

                                // Only one road exists in the result:
                                // show all postcode variants directly.
                                if (vejnavne.length === 1) {
                                    var only = vejnavne[0];

                                    var seen2 = {};
                                    var items2 = [];

                                    navngiven.forEach(function (f) {
                                        if (f.vejnavn !== only) {
                                            return;
                                        }

                                        var key =
                                            (f.postnr || "") +
                                            "|" +
                                            (f.id || "");

                                        if (seen2[key]) {
                                            return;
                                        }

                                        seen2[key] = true;

                                        items2.push({
                                            displayname:
                                                f.titel ||
                                                (f.vejnavn + " " + f.postnr),

                                            id: f.id || key,
                                            postnr: f.postnr,
                                            postdistrikt: f.postdistrikt,
                                            type: f.type,
                                            roadOnly: false,
                                            vejnavn: f.vejnavn
                                        });
                                    });

                                    options.success(items2);
                                    return;
                                }

                                // Multiple roads:
                                // only show each road name once.
                                if (vejnavne.length > 0) {
                                    var distinctResults =
                                        vejnavne.map(function (vejnavn) {
                                            return {
                                                displayname: vejnavn,
                                                id: vejnavn,
                                                roadOnly: true,
                                                vejnavn: vejnavn
                                            };
                                        });

                                    options.success(distinctResults);
                                    return;
                                }

                                // No matching navngivenvejpostnummer results
                                options.success([]);
                            },

                            error: function (
                                xhr,
                                status,
                                errorThrown
                            ) {
                                options.error(xhr);

                                fejlikommunikationVejnavne(
                                    xhr,
                                    status,
                                    errorThrown
                                );
                            }
                        });
                    }
                }
            }
        }).data("kendoAutoComplete");
    });

    function fejlikommunikationVejnavne(
        xhr,
        status,
        errorThrown
    ) {
        alert(
            "Fejl i adresseopslaget: Status: " +
            status +
            ", errorThrown: " +
            errorThrown
        );
    }

