    function fejlikommunikationVejnavne(xhr, status, errorThrown) {
        alert("Fejl i adresseopslaget: Status: " + status + ", errorThrown: " + errorThrown);
    };

    function loadVejnavnOpslagHusnumrene(vejkode, postnr) {
        //url: 'http://geo.oiorest.dk/adresser.json',
        //alert('loadhusnumre');
        var argumenter = {};
        argumenter.vejkode = vejkode;
        argumenter.postnr = postnr;
        argumenter.srid = 25832;
        $.ajax({
            url: 'https://dawa.aws.dk/adresser',
            data: argumenter,
            dataType: "jsonp",            
            error: fejlikommunikationVejnavne,
            jsonpCallback: 'findMedianHusnummer'
        });
    }

    function findMedianHusnummer(husnr) {
        //alert('findMedianHusnummer');
        //json objektet laves om til et array af adresser
        var values = [];
        $.each(husnr, function (i, hn) {
            var adr = {
                adgangsadresse: hn.id,
                vejnavn: hn.adgangsadresse.vejstykke.navn,
                kommunenavn: hn.adgangsadresse.kommune.navn,
                kommunekode: hn.adgangsadresse.kommune.kode,
                ejerlavkode: (hn.adgangsadresse.ejerlav == null ? 0 : hn.adgangsadresse.ejerlav.kode),
                ejerlavnavn: (hn.adgangsadresse.ejerlav == null ? '' : hn.adgangsadresse.ejerlav.navn),
                matrikelnr: hn.matrikelnr,
                esrejendomsnr: hn.esrejendomsnr,
                x: hn.adgangsadresse.adgangspunkt.koordinater[0],
                y: hn.adgangsadresse.adgangspunkt.koordinater[1],
                postdistrikt: hn.adgangsadresse.postnummer.navn,
                postnummer: hn.adgangsadresse.postnummer.nr,
                wkt: "POINT(" + hn.adgangsadresse.adgangspunkt.koordinater[0] + " " + hn.adgangsadresse.adgangspunkt.koordinater[1] + ")"
            };
            values.push(adr);


        });

        var countRows = values.length;
        if (countRows > 0) {
            var adr;
            if (countRows == 1) {
                adr = values[0];
                mapStedNavigateToBbox(Math.round(adr.x) - 200, Math.round(adr.y) - 200, Math.round(adr.x) + 200, Math.round(adr.y) + 200);
        
            } else {
                var median = countRows / 2;
                median = Math.floor(median);
                //mapStedNavigateToWkt(values[median].wkt);

                adr = values[median];
                if (adr.x != null) {
                    mapStedNavigateToBbox(Math.round(adr.x) - 200, Math.round(adr.y) - 200, Math.round(adr.x) + 200, Math.round(adr.y) + 200);

                    $("#MapStedLx").val(Math.round(adr.x) - 200);
                    $("#MapStedLy").val(Math.round(adr.y) - 200);
                    $("#MapStedUx").val(Math.round(adr.x) + 200);
                    $("#MapStedUy").val(Math.round(adr.y) + 200);
                }
            }


            //$("#divEjendomAdresseEdit").hide();
            //$("#divOffvejAdresseEdit").hide();
            $("#divAdresseView").show();
            $("#divOffVejMapDigPolygon").show();

            $("#hflAdresse").val(adr.vejnavn);
            $("#txtAdresse").val(adr.vejnavn);

            $("#txtKommune").val(adr.kommunenavn);
            $("#hflKommuneKode").val(adr.kommunekode);
            $("#hflPostDistrikt").val(adr.postdistrikt);
            $("#hflPostnummer").val(adr.postnummer);
            $("#txtPostDistrikt").val(adr.postdistrikt);
            $("#txtPostnummer").val(adr.postnummer);
      
            //Ryd tidligere indtegnet område
            $("#hflOprindelsesstedWkt").val("");
            mapStedClearRedline();

        }
    }

