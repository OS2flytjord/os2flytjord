@using System.Collections.ObjectModel
@using System.Globalization
@using System.Net.Configuration
@using Niras.Jordflytning.Core.Models
@model Niras.Jordflytning.ViewModels.Anmeldelse.OpretModel


@helper formatText(string[] parts)
{
    <text>
        @Html.Raw(string.Join("<br />", parts))
    </text>
}

@helper GetAnmelder()
{
    var parts = new[] { "", "", "" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Anmelder != null && Model.Anmeldelse.Anmelder.Person != null)
    {
        // Firma
        if (Model.Anmeldelse.Anmelder.Person.Firmaoplysninger != null)
        {
            parts[0] = Model.Anmeldelse.Anmelder.Person.Firmaoplysninger.Firmanavn;
            parts[1] = Model.Anmeldelse.Anmelder.Person.Navn + " " + Model.Anmeldelse.Anmelder.Person.Efternavn;
        }
        else // Privat
        {
            parts[0] = Model.Anmeldelse.Anmelder.Person.Navn + " " + Model.Anmeldelse.Anmelder.Person.Efternavn;
            parts[1] = "";
        }
        if (Model.Anmeldelse.Anmelder.Person.Telefon != null)
        {
            parts[2] = Model.Anmeldelse.Anmelder.Person.Telefon.Value.ToString();
        }
    }
    @formatText(parts);
}

@helper GetOprindelse()
{
    var parts = new[] { "", "", "", "", "" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Oprindelsessted != null)
    {
        if (Model.Anmeldelse.Oprindelsessted.OprindelsesstedKlassifikationType != null && Model.Anmeldelse.Kommune != null)
        {
            switch (Model.Anmeldelse.Oprindelsessted.OprindelsesstedKlassifikationType.Id.ToString().ToUpper())
            {
                case "BBB062F1-641A-45AD-BEDD-B0C126FCDFE6":
                    {
                        parts[0] = "Ejendom";
                        parts[1] = Model.Anmeldelse.Oprindelsessted.Adresse + ", " + Model.Anmeldelse.Oprindelsessted.Postnummer + " " + Model.Anmeldelse.Oprindelsessted.PostDistrikt;
                        break;
                    }
                case "295407E9-2182-4876-AE6F-50AFD00A6194":
                    {
                        parts[0] = "Offentlig vej";
                        parts[1] = Model.Anmeldelse.Oprindelsessted.Adresse + ", " + Model.Anmeldelse.Oprindelsessted.Postnummer + " " + Model.Anmeldelse.Oprindelsessted.PostDistrikt;
                        break;
                    }
                case "480738EC-4A9D-448E-9A18-5BA481A8A3C6":
                    {
                        parts[0] = "Anden oprindelse";
                        parts[1] = Model.Anmeldelse.Oprindelsessted.Beskrivelse;
                        break;
                    }
            }
        }

        if (Model.Anmeldelse.Oprindelsessted.Matrikel != null && Model.Anmeldelse.Oprindelsessted.Matrikel.Count > 0)
        {
            foreach (var m in Model.Anmeldelse.Oprindelsessted.Matrikel)
            {
                parts[2] += (parts[2] != "" ? "; " : "") + m.Matrikelnr + ", " + m.Ejerlavsnavn;
            }
        }
        parts[3] = Model.Anmeldelse.Oprindelsessted.PostDistrikt;

        if (Model.Anmeldelse.Oprindelsessted.AndenOprindJordTypeID != new Guid("295407E9-2182-4876-AE6F-50AFD00A6194")) // Alt andet end offentlig vej
        {
            if (Model.ForureningsKategoriTekster != null)
            {
                if (!Model.ForureningsKategoriTekster.Any())
                {
                    parts[4] = "(Der er ikke registreret oplysninger om jordforurening på arealet)";
                }
                else
                {
                    foreach (var text in Model.ForureningsKategoriTekster)
                    {
                        parts[4] += (!string.IsNullOrWhiteSpace(parts[4]) ? "<br>" : "") + text;
                    }
                }
            }
            else
            {
                parts[4] += "Fejl: Kunne ikke hente forureningsoplysninger!";
            }
        }
    }
    @formatText(parts);
}

@helper GetJordproever()
{
    var parts = new string[] { "" };
    if (Model.Anmeldelse != null)
    {
        if (Model.Anmeldelse.Jord == null || Model.Anmeldelse.Jord.Jordproever.HasValue == false)
        {
            parts[0] = "Er ikke udtaget";
        }
        else
        {

            if (Model.Anmeldelse.Jord.Jordproever.Value)
            {
                parts[0] = "Er udtaget af " + Model.Anmeldelse.Jord.MiljoeTekniskTilsyn;

                if (Model.Anmeldelse.Jord.JordproeverFoer.HasValue)
                {
                    if (Model.Anmeldelse.Jord.JordproeverFoer.Value)
                    {
                        parts[0] += " før opgravningen";
                    }
                    else
                    {
                        parts[0] += " efter opgravningen";
                    }
                }
            }
            else
            {
                parts[0] = "Er ikke udtaget";
            }
        }
    }
    @formatText(parts)
}

@helper GetForureningsKategori()
{
    var parts = new string[] { "" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Jord != null && Model.Anmeldelse.Jord.JordKlassifikationType != null)
    {
        parts[0] = Model.Anmeldelse.Jord.JordKlassifikationType.Navn;
    }
    @formatText(parts)
}

@helper GetJordDokumentation()
{
    var parts = new string[] { "", "", "" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Jord != null)
    {
        parts[0] = string.Format("<input type=\"checkbox\" onclick=\"return false;\" {0}>Intakt jord</checkbox>", Model.Anmeldelse.Jord.IntaktJord ? "checked=checked" : string.Empty);
        parts[1] = string.Format("<input type=\"checkbox\" onclick=\"return false;\" {0}>Jordhåndteringsplan vedlagt</checkbox>", Model.Anmeldelse.Jord.StraksGodkendJordhaandteringsplan ?? false ? "checked=checked" : string.Empty);
        parts[2] = string.Format("<input type=\"checkbox\" onclick=\"return false;\" {0}>Anden dokumentation</checkbox>", Model.Anmeldelse.Jord.Dokumentation != null && Model.Anmeldelse.Jord.Dokumentation.Any() ? "checked=checked" : string.Empty);
    }
    @formatText(parts)
}

@helper GetAffald()
{
    var parts = new string[] { "" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Jord != null && Model.Anmeldelse.Jord.AffaldType != null)
    {
        parts[0] = "Jorden indeholder affald af typen <b>";
        if (Model.Anmeldelse.Jord.AffaldType.Kode != 6 || (Model.Anmeldelse.Jord.AffaldType.Kode == 6 && string.IsNullOrWhiteSpace(Model.Anmeldelse.Jord.AndenAffaldType)))
        {
            parts[0] += Model.Anmeldelse.Jord.AffaldType.Navn.ToLower();
        }
        else
        {
            parts[0] += Model.Anmeldelse.Jord.AndenAffaldType;
        }
        parts[0] += "</b>";
    }
    else
    {
        parts[0] = "Jorden indeholder ikke affald";
    }
    @formatText(parts)
}

@helper GetJordflytningType()
{
    var parts = new List<string> { "" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Jord != null && Model.Anmeldelse.Jord.JordflytningType != null)
    {
        parts[0] = Model.Anmeldelse.Jord.JordflytningType.Navn;
        if (Model.Anmeldelse.Jord.StraksGodkendJordhaandteringsplan ?? false == true)
        {
            parts.Add("Jordhåndteringsplan er indsendt til kommunen");
        }
    }
    @formatText(parts.ToArray())
}


