@helper GetPoint()
{
    var parts = new string[] { "0.0", "0.0" };
    if (Model.Anmeldelse != null && Model.Anmeldelse.Oprindelsessted != null && Model.Anmeldelse.Oprindelsessted.Geom != null)
    {
        parts[0] = (Model.Anmeldelse.Oprindelsessted.Geom.XCoordinate ?? 0.0).ToString(CultureInfo.InvariantCulture);
        parts[1] = (Model.Anmeldelse.Oprindelsessted.Geom.YCoordinate ?? 0.0).ToString(CultureInfo.InvariantCulture);
    }
    @Html.Raw("{ x: " + parts[0] + ", y: " + parts[1] + " }")
}

