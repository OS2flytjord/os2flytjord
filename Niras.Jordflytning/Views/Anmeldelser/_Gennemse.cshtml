@helper GetDokumenter()
{
    var parts = new List<string>();
    if (Model.Revision)
    {
        if (Model.RevisionAnmeldelse != null && Model.RevisionAnmeldelse.Jord != null && Model.RevisionAnmeldelse.Jord.Dokumentation != null)
        {
            foreach (var dokument in Model.RevisionAnmeldelse.Jord.Dokumentation.GroupBy(x => x.Id).Select(x => x.First()))
            {
                parts.Add(dokument.Filnavn);
            }
        }
    }
    else
    {
        if (Model.Anmeldelse != null && Model.Anmeldelse.Jord != null && Model.Anmeldelse.Jord.Dokumentation != null)
        {
            foreach (var dokument in Model.Anmeldelse.Jord.Dokumentation.GroupBy(x => x.Id).Select(x => x.First()))
            {
                parts.Add(dokument.Filnavn);
            }
        }
    }
    if (!parts.Any())
    {
        parts.Add("(Ingen dokumenter)");
    }
    @formatText(parts.ToArray())
}

