<style>
    .autocomplete-container {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .autocomplete-container input {
        box-sizing: border-box;
        background-color: #FFFFFF;
        width: 475px;
        border: 1px solid #ccc;
        background: transparent;
        color: #676767;
        font-family: inherit;
        margin: 1px 0 1px 0;
        padding: 2px !important;
        padding-left: 6px !important;
        height: 2em;
        line-height: 1.31em;
    }

    .adressevaelger-suggestions {
        width: 475px;
        padding: 0;
        margin: 0;
        text-align: left;
        border-radius: .3125em;
        background: #fcfcfc;
        box-shadow: 0 .0625em .15625em #00000026;
        left: 0;
        right: 0;
        z-index: 9999;
        overflow-y: auto;
        max-height: 250px;
        box-sizing: border-box
    }

    .adressevaelger-suggestions .adressevaelger-suggestion {
        margin: 0;
        list-style: none;
        cursor: pointer;
        padding: .4em .6em;
        color: #333;
        border: .0625em solid #ddd;
        border-bottom-width: 0
    }

    .adressevaelger-suggestions .adressevaelger-suggestion:first-child {
        border-top-left-radius: inherit;
        border-top-right-radius: inherit
    }

    .adressevaelger-suggestions .adressevaelger-suggestion:last-child {
        border-bottom-left-radius: inherit;
        border-bottom-right-radius: inherit;
        border-bottom-width: .0625em
    }

    .adressevaelger-suggestions .adressevaelger-suggestion.dawa-selected, .adressevaelger-suggestions .adressevaelger-suggestion:hover {
        background: #f0f0f0
    }
</style>