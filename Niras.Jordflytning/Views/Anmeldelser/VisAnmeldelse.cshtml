<div id="winModtagerAnlaegKort" style="display: none">
    @*Modal vindue til visning af modtagerAnlaeget i kortet.*@
</div>

<div id="winModtagerAnlaegDokumenter" style="display: none">
    @*Modal vindue til visning af modtagerAnlaegets dokumenter.*@
</div>

@Html.HiddenFor(m => m.MatrikelWkt, new { id = "hflMatrikelWkt" })
@Html.HiddenFor(m => m.Anmeldelse.Id, new { id = "hflAnmeldelseId" })

<script type="text/javascript">
    $(document).ready(function () {
        var kiSite = 'Jordflytning';
        var kiPageSted = 'default';

        mapInitSted(kiSite, kiPageSted);


    });

    function openModtagerAnlaegKort(id, modtageranlaegnavn) {
        var wdiv = $("#winModtagerAnlaegKort").kendoWindow({
            iframe: true,
            content: "/ModtagerAnlaeg/Kort?modtagerAnlaegId=" + id,
            type: "GET",
            height: 600,
            width: 900
        });
        wdiv.data("kendoWindow").title(modtageranlaegnavn);
        wdiv.data("kendoWindow").center();
        wdiv.data("kendoWindow").open();
    }

    function showDocModalWindow(modtageranlaegId, modtageranlaegnavn) {
        var wdiv = $("#winModtagerAnlaegDokumenter").kendoWindow({
            iframe: true,
            content: "/ModtagerAnlaeg/Dokumenter?modtagerAnlaegId=" + modtageranlaegId,
            type: "GET",
            height: 600,
            width: 900
        });
        wdiv.data("kendoWindow").title(modtageranlaegnavn);
        wdiv.data("kendoWindow").center();
        wdiv.data("kendoWindow").open();
    }

    function getMatrikelWktForHistoriskeDokumentation() {
        var aid = '00000000-0000-0000-0000-000000000000';
        if ($("#hflAnmeldelseId").val() != '') {
            aid = $("#hflAnmeldelseId").val();
        }

        return {
            excludeAnmeldelseId: aid,
            matrikelWkt: $("#hflMatrikelWkt").val()
        };
    }

</script>