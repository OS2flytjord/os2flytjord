@model Niras.Jordflytning.ViewModels.Anmeldelse.OpretModel
<div id="divValideringListe">
    @if (Model.ValideringList != null && Model.ValideringList.Count > 0)
    {
        @:<p>
            string mes = "";
            foreach (var ss in Model.ValideringList)
            {
                @Html.Raw(ss) @:<br />
            }

        @:</p>
    }
</div>
<div id="divValideringJordforureningopslagAdvarsel"></div>
@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <script type="text/javascript">
    displayMessage('@ViewBag.Message');
    </script>
}


