@model Niras.Jordflytning.ViewModels.Anmeldelse.OpretModel

<div id="divSted" class="row" style="margin-top: 10px">
    <div class="column" id="divStedLeft" style="width: 495px; margin-right: 10px;">
        <div id="oprindelsessted" class="controlsbox row">
            <div class="cbheader">
                <h5>Oprindelsessted</h5>
            </div>

            <div class="row_control" id="divAdresseSearch">
                <div class="row_line">
                    @{
                        //Html attribut beregnes ud fra tidliger
                        var d0 = new Dictionary<string, object>();
                        d0.Add("Id", "stedTypeEjendom");
                        d0.Add("Style", "margin-left:0;");
                        if (Model.OprindelsesstedKlassifikationTypeSelectedIndex == 0)
                        {
                            d0.Add("checked", "checked");
                        }

                        var d1 = new Dictionary<string, object>();
                        d1.Add("Id", "stedTypeOffentligVej");
                        if (Model.OprindelsesstedKlassifikationTypeSelectedIndex == 1)
                        {
                            d1.Add("checked", "checked");
                        }

                        var d2 = new Dictionary<string, object>();
                        d2.Add("Id", "stedTypeAndenOprindelse");
                        if (Model.OprindelsesstedKlassifikationTypeSelectedIndex == 2)
                        {
                            d2.Add("checked", "checked");
                        }
                    }
                    @Html.RadioButtonFor(m => m.Anmeldelse.Oprindelsessted.OprindelsesstedKlassifikationType.Id, "BBB062F1-641A-45AD-BEDD-B0C126FCDFE6", d0)
                    @Html.Label("rblOprindelsesstedKlas", "Ejendom", new { Class = "labelradio" })
                    @Html.RadioButtonFor(m => m.Anmeldelse.Oprindelsessted.OprindelsesstedKlassifikationType.Id, "295407E9-2182-4876-AE6F-50AFD00A6194", d1)
                    @Html.Label("rblOprindelsesstedKlas", "Offentlig vej", new { Class = "labelradio" })
                    @Html.RadioButtonFor(m => m.Anmeldelse.Oprindelsessted.OprindelsesstedKlassifikationType.Id, "480738EC-4A9D-448E-9A18-5BA481A8A3C6", d2)
                    @Html.Label("rblOprindelsesstedKlas", "Anden oprindelse", new { Class = "labelradio" })
                    <div style="clear: both"></div>
                </div>

                <div class="row" style="display: block">
                    <div id="divEjendom" style="display: @(Model.OprindelsesstedKlassifikationTypeSelectedIndex == 0 ? "block" : "none") ">
                        <div id="divEjendomAdresseEdit">
                            <div class="row_line" id="divEjendomAdresseOpslagEdit" style="margin-left: -5px; display: @(Model.AdresseOpslagViewMode == false ? "block" : "none")">
                                @Html.Partial("~/Views/Anmeldelser/_AdresseOpslag.cshtml")
                            </div>
                            <div style="clear: both"></div>
                            <div class="row_line">
                                @Html.Label("Materiale-/jordtype")
                                @(Html.Kendo().DropDownListFor(x => x.SelectedEjendomMaterialeTypeID)
                                      .HtmlAttributes(new { @id = "EjendomListe", @style = "width:62%" })
                                              .OptionLabel("Vælg, hvis aktuelt")
                                      .DataTextField("Text")
                                      .DataValueField("Value")
                                      .BindTo(Model.EjendomJordTypeListe)
                                )
                            </div>
                        </div>
                        <div class="row_line" id="divEjendomMapDigPolygon" style="display: none">
                             @Html.Label("Indtegn i kort")
                            <input type="button"
                                   id="btnEjendomMapDigPolygon"
                                   value="Tegn" onclick="mapStedDigitaliser()"
                                   data-tooltip="Klik her for at starte indtegning i kortet af området, som jordflytningen vedrører" />
                        </div>
                        <div style="clear: both"></div>
                    </div>
                </div>

                <div class="row">
                    <div id="divOffentligVej" style="display: @(Model.OprindelsesstedKlassifikationTypeSelectedIndex == 1 ? "block" : "none") ">
                        <div id="divOffvejAdresseEdit">
                            <div class="row_line">
                                <div class="row_line" id="divOffvejAdresseOpslagEdit" style="display: @(Model.AdresseOpslagViewMode == false ? "block" : "none")">
                                    @Html.Partial("~/Views/Anmeldelser/_VejOpslag.cshtml")
                                </div>
                                <div style="clear: both"></div>
                                <div class="row_line">
                                    @Html.Label("Materiale-/jordtype")
                                    @(Html.Kendo().DropDownListFor(x => x.SelectedOffentligVejMaterialeTypeID)
                                        .HtmlAttributes(new { @id = "VejListe", @style = "width:62%" })
                                                .OptionLabel("Vælg, hvis aktuelt")
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .BindTo(Model.VejJordTypeListe)
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row_line" id="divOffVejMapDigPolygon" style="display: none">
                            <label>Indtegn i kort *</label>
                            <input type="button" id="btnOffVejMapDigPolygon"
                                   value="Tegn" onclick="mapStedDigitaliserVej()"
                                   data-tooltip="Klik her for at starte indtegning i kortet af området, som jordflytningen vedrører    " />
                            <input type="button" id="btnOffVejMapDigClean"
                                   value="Ryd" onclick="mapStedClearRedline()"
                                   data-tooltip="Klik her for at ryd de indtegnet områder    " />
                        </div>
                        <div style="clear: both"></div>

                    </div>
                </div>
                <div style="display: @(Model.OprindelsesstedKlassifikationTypeSelectedIndex != 2 ? "block" : "none") " class="row">
                    <div id="divAdresseView" style="display: @(Model.AdresseOpslagViewMode ? "block" : "none") ">

                        <div class="row_line">
                            @Html.Label("Adresse")
                            @Html.TextBoxFor(m => m.Anmeldelse.Oprindelsessted.Adresse, new { style = "padding-left:0px; width:62%;", Id = "txtAdresse", @class = "readonly", @readonly = true })

                        </div>
                        <div class="row_line">
                            @Html.Label("Postnummer")
                            @Html.TextBoxFor(m => m.Anmeldelse.Oprindelsessted.Postnummer, new { Id = "txtPostnummer", @class = "readonly", @readonly = true, @style = "width:34px; padding-left:0px; margin-right:10px;" })
                            @Html.TextBoxFor(m => m.Anmeldelse.Oprindelsessted.PostDistrikt, new { Id = "txtPostDistrikt", @class = "readonly", @readonly = true, @style = "width:154px; padding-left:0px;" })

                        </div>
                        <div class="row_line">
                            @Html.Label("Kommune")
                            @Html.TextBoxFor(x => x.Anmeldelse.Kommune.Navn, new { style = "padding-left:0px; width:32%;", id = "txtKommune", @class = "readonly", @readonly = true })
                        </div>

                        <div id="divStedOffVejLinkTilEksternsystem" class="row_line" style="display: @(Model.OprindelsesstedKlassifikationTypeSelectedIndex == 1 ? "block" : "none") ">
                            @Html.Label("Link til ekstern system")
                            @Html.TextBoxFor(t => t.Anmeldelse.Oprindelsessted.OffvejUrl, new { maxlength = 500, @style = "width:62%;" })
                        </div>

                        <div class="row_line">
                            @if (!Model.LockAnmeldelse && !Model.LockJorden)
                            {
                                <input type="button" value="Nyt sted" id="btnStedNyEjendom" data-tooltip="Vælg nyt oprindelsessted" style="min-width: 90px; width: 90px; margin-right: 66px; margin-top: 20px; margin-bottom: 0px;" />
                                <input type="button" value="Hent aktuel forureningsstatus" id="btnStedSoegEksterneSystemer" style="margin-top: 20px; margin-bottom: 0px;display:none;" />
                            }
                        </div>
                    </div>
                </div>
                <div class="row_line">
                    <div id="divAndenOprindelse" style="display: @(Model.OprindelsesstedKlassifikationTypeSelectedIndex == 2 ? "block" : "none") ">

                        @*<div class="row_line">
                            @Html.Label("Materiale")
                            @(Html.Kendo().DropDownListFor(x => x.SelectedAndenOprindJordTypeID)
                                .OptionLabel("Vælg")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .BindTo(Model.AndenOprindJordTypeListe)
                            )
                        </div>*@
                        <div class="row_line">
                            @Html.Label("Kommune")
                            @(Html.Kendo().DropDownListFor(x => x.selectedAndenOprindelsesstedKommune)
                                  .HtmlAttributes(new { @style = "width:62%" })
                                  .OptionLabel("Vælg")
                                  .DataTextField("Text") //Specifies which property of the Product to be used by the dropdownlist as a text.
                                  .DataValueField("Value") //Specifies which property of the Product to be used by the dropdownlist as a value.
                                  .BindTo(Model.StedKommuneListe)   //Pass the list of Products to the dropdownlist.
                                  .Events(e => e.Change("andenOprindelsesstedKommuneChanged"))
                                  )
                        </div>
                        <div style="clear: both"></div>
                        <div class="row_line">
                            @Html.Label("Materiale-/jordtype")
                            @(Html.Kendo().DropDownListFor(x => x.SelectedAndenOprindJordTypeID)
                                  .HtmlAttributes(new { @id = "AndenListe" , @style = "width:62%" })
                                          .OptionLabel("Vælg")
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .BindTo(Model.AndenJordTypeListe)
                            )
                        </div>
                        <div style="clear: both"></div>
                        <div class="row_line">
                            @*Html.LabelFor(x => x.Anmeldelse.Oprindelsessted.Beskrivelse)*@
                            <label><span>Beskrivelse </span><span style="color:red; font-size:11px; line-height:11px; display: block;">(der må ikke indtastes persondata)</span></label>
                            @Html.TextBoxFor(x => x.Anmeldelse.Oprindelsessted.Beskrivelse, new { maxlength = 500, style="height:80px; width:62%" })
                        </div>
                    </div>
                </div>
            </div>

            <div style="clear: both"></div>
        </div>

        <div id="divStedJordforureningOpslag" class="row" style="margin-top: 5px; display: none">
            @Html.Partial("~/Views/Anmeldelser/_stedJordforuningopslag.cshtml", Model)
        </div>
    </div>

    <div id="divStedRight" class="column" style="width: 500px; margin-left: 0px">
        <div class="row" id="stedRight" style="height: 410px">
            <div style="border: solid 0 #000; height: 100%; width: 100%;" id="divMapContainer">

                <div class="row">
                    <div id="divMapSted" class="kiMap" style="width: 100%; height: 410px"></div>
                    <img id="imgMinimise" src="/Content/images/cross.png" title="Skift til lille kort" style="display: none;">
                    <img id="imgMaximise" src="/Content/images/application_side_contract.png" title="Skift til stort kort">
                    <img id="imgSignatur" src="/Content/images/Signatur.png" title="" />
                    <img id="imgSignaturForklaringExpand" src="/Content/images/Pil_ned.png" title="Udvid signaturforklaring" />
                    <img id="imgSignaturForklaringColapse" src="/Content/images/Pil_op.png" title="Minimer signaturforklaring" />
                    <img id="imgSignaturForklaring" src="/Content/images/Signaturforklaring_FJ_small.png" title="" />

                </div>
            </div>
            <div style="clear: both"></div>
        </div>
        <div id="divStedHelpMap" class="controlsbox row" style="margin-top: 5px; padding-bottom:0px;">
            <div class="cbheader">
                <h5>Hjælp til søgning i kortet</h5>
            </div>
            <div class="row_control">
                <p>Arealet for den valgte adresse bliver indtegnet i kortet. </p>
                <p>Skal jordflytningen ske fra et andet areal, eller et mindre område på det valgte areal, skal du indtegne det aktuelle areal i kortet ved at aktivere knappen 'Tegn' i venstre boks. Herrefter vil de eksterne forureningsdata for dette areal blive hentet automatisk.</p>
                <p>Ligger det indtegnede areal på en anden adresse, er det VIGTGT, at du noterer denne adresse som oprindelsesadressen.</p>
            </div>

            <div style="clear: both"></div>
        </div>

    </div>
</div>
<div style="clear: both"></div>

@Html.HiddenFor(x => x.OprindelsesstedWkt, new { id = "hflOprindelsesstedWkt" })
@Html.HiddenFor(x => x.Anmeldelse.Oprindelsessted.Postnummer, new { id = "hflPostnummer" })
@Html.HiddenFor(x => x.Anmeldelse.Oprindelsessted.PostDistrikt, new { id = "hflPostDistrikt" })
@Html.HiddenFor(x => x.Anmeldelse.Oprindelsessted.Adresse, new { id = "hflAdresse" })
@Html.HiddenFor(x => x.Anmeldelse.Kommune.Kommunenr, new { id = "hflKommuneKode", @Value = "-1" })

@Html.HiddenFor(x => x.MapStedLx, new { id = "MapStedLx" })
@Html.HiddenFor(x => x.MapStedLy, new { id = "MapStedLy" })
@Html.HiddenFor(x => x.MapStedUx, new { id = "MapStedUx" })
@Html.HiddenFor(x => x.MapStedUy, new { id = "MapStedUy" })

<script type="text/javascript">
    function loadAndenOprindelseJordklassifikationerForKommune() {
        $.post("@Url.Action("GetJordKlassifikationerForKommuneAndenOprindelse", "Anmeldelser")", $("#formOpretAnmeldelse").serialize(), function (resultJordKlassifikation) {
                if (resultJordKlassifikation) {
                    $("#divJordKlassifiktion").html(resultJordKlassifikation); //Erstatter alt inde for div'en med det partial view

                }
            }
        );
    }

    function andenOprindelsesstedKommuneChanged() {
        loadAndenOprindelseJordklassifikationerForKommune();
    }

    function maxMap() {
        var winMaxMap = $("#divMapContainer").kendoWindow({
            height: "80%",
            width: "80%",
            modal: true
        }).data("kendoWindow");

        winMaxMap.open();
        winMaxMap.maximize();
        $("#divMapSted").height('700px');
    }

    function adresseFundet(adr) {
        $('#divEjendomAdresseOpslagEdit').hide();
        $("#divAdresseView").show();

        //Kort
        mapSted.setReadyListener(function () {
            if (adr.x != null) {
                mapStedNavigateToBbox(Math.round(adr.x) - 50, Math.round(adr.y) - 50, Math.round(adr.x) + 50, Math.round(adr.y) + 50);

                $("#MapStedLx").val(Math.round(adr.x) - 50);
                $("#MapStedLy").val(Math.round(adr.y) - 50);
                $("#MapStedUx").val(Math.round(adr.x) + 50);
                $("#MapStedUy").val(Math.round(adr.y) + 50);

                $("#hflOprindelsesstedWkt").val("POINT(" + Math.round(adr.x) + " " + Math.round(adr.y) + ")");
            }
        });

        mapStedRedlineWkt($("#hflOprindelsesstedWkt").val());

        $("#hflAdresse").val(adr.vejnavn + " " + adr.husnr);
        $("#txtAdresse").val(adr.vejnavn + " " + adr.husnr);
        $("#txtKommune").val(adr.kommunenavn);
        $("#hflPostDistrikt").val(adr.postdistrikt);
        $("#hflPostnummer").val(adr.postnummer);
        $("#txtPostDistrikt").val(adr.postdistrikt);
        $("#txtPostnummer").val(adr.postnummer);

        if (adr.kommunenavn == "Roskilde" || adr.kommunenavn == "Hvidovre" || adr.kommunenavn == "Høje-Taastrup") {
            $("#divStedJordforureningOpslag").hide();         
        }
        else {
            getJordForurening();

            $("#divStedJordforureningOpslag").show();
        }  
        
        $("#divEjendomMapDigPolygon").show();
 
    }

    function getJordForurening() {
        // Forspøg ikke på JordForurenings Opslag når det er offentligvej!
        if($("#stedTypeOffentligVej").prop("checked")) {
            return false;
        }

        //Nulstil resultat
        $("#labelResultatJord").empty();
        $("#divResultat").empty();
        $("#labelResultatJord").html("Der foretages opslag i eksterne systemer. Vent venligst.");
        $("#resultatJordProgress").show();
        $("#btnKvittering").hide();
        $("#hvadvildunu").hide();

        //Henter forureningskategorierne for kommunen. getJordForurening() kaldes efter der er blevet lavet et adresse eller vej opslag.
        $.post("@Url.Action("GetJordKlassifikationerForKommune", "Anmeldelser")", $("#formOpretAnmeldelse").serialize(), function (resultJordKlassifikation) {
            if (resultJordKlassifikation) {
                var jordKlassifiktionId = '#divJordKlassifiktion';
                if (@Model.Revision.ToString().ToLower()){
                    jordKlassifiktionId = '#divJordKlassifiktionRevision';
                }
                $(jordKlassifiktionId).html(resultJordKlassifikation); //Erstatter alt inde for div'en med det partial view som man ved GetJordForurening

                $.post("@Url.Action("GetJordForurening", "Anmeldelser")", $("#formOpretAnmeldelse").serialize(), function (result) {
                    if (result) {
                        $("#divStedJordforureningOpslag").html(result); //Erstatter alt inde for div'en med det partial view som man ved GetJordForurening

                        //Advarsel i forbindelse med jordforureningsopslaget tilføjes _validering partial viewet
                        var jfMessage = $("#divStedJordforureningopslagAdvarsel").html();
                        $("#divValideringJordforureningopslagAdvarsel").html(jfMessage);
                        if (jfMessage != '') {
                            $("#divValidering").show();
                        } else {
                            $("#divValidering").hide();
                        }

                        $("#resultatJordProgress").hide();
                        $("#labelResultatJord").empty();
                        $("#divResultatPrint").empty();

                        $("#btnKvittering").show();
                        $("#hvadvildunu").show();

                        //Når der er lavet et opslag må knapperne gerne være enable.
                        $("#btnGem").removeAttr("disabled");
                        $("#btnRaadgiver").removeAttr("disabled");
                        $("#btnAfsend").removeAttr("disabled");

                        var forureningOpslagFejlbesked = $("#hflForureningOpslagFejlbesked").val();
                        var forureningOpslagJordklassifikationTypeId = $("#hflForureningOpslagJordklassifikationTypeId").val();
                        var forureningOpslagKraeverAnmeldelse = $("#hflForureningOpslagKraeverAnmeldelse").val();
                        var forureningOpslagResultat = $("#hflForureningOpslagResultatList").val();

                        $("#hflJordKlassifikationType").val(forureningOpslagJordklassifikationTypeId); //selected jordklassifikationstype sættes til værdien fra jordforurningsopslaget.

                        //Fejl
                        if (forureningOpslagFejlbesked != "") {
                            alert(forureningOpslagFejlbesked);
                        } else {
                            //Kræver Anmeldelse?
                            if (forureningOpslagKraeverAnmeldelse == "True") {
                                $("#btnTilJorden").show();
                                $("#btnTilModtager").hide();

                                $("#btnTilJorden").click(function() {
                                    $("#tab_2").click();
                                });

                                $("#tab_3").removeAttr("disabled");
                                $("#tab_4").removeAttr("disabled");
                                $("#tab_5").removeAttr("disabled");

                            } else {
                                $("#btnTilJorden").hide();
                                $("#btnTilModtager").show();
                                $("#btnTilModtager").click(function() {
                                    $("#tab_3").click();
                                });
                            }

                            //Resultat af opslaget
                            $("#labelResultatJord").html(forureningOpslagResultat);
                            $("#divResultatPrint").html(forureningOpslagResultat);

                            $("#btnKvittering").click(function(e) {
                                e.preventDefault();
                                window.open("/Default/kvittering", "_blank");
                            });

                            //Sætter jordklassifikation
                            var className = '.jordklassifikationTypeRadiolist';
                            if (@Model.Revision.ToString().ToLower()){
                                className = '.jordklassifikationRevisionTypeRadiolist';
                            }
                            
                            $(className).each(function() {
                                if ($(this).val() == forureningOpslagJordklassifikationTypeId) {
                                    $(this).prop('checked', true);
                                } else {
                                    $(this).removeAttr('checked');
                                }
                            });

                            //Redliner matriklerne
                            mapStedRedlineMatrikelWkt($("#hflMatrikelWkt").val());

                            //Indlæser modtagerne igen nu med jordklassificering som filtreringsparameter
                            window.popModtagerAnlaeg();

                            window.popHistoriskDokumentationGrid();
                        }
                    }
                });

            }
        });


    }

    function adresseNulstil() {
        $("#resultatJord").hide();
        $("#hvadvildunu").hide();

        $("#tab_2").attr("disabled", "disabled");
        $("#tab_3").attr("disabled", "disabled");
        $("#tab_4").attr("disabled", "disabled");
        $("#tab_5").attr("disabled", "disabled");


    }

    function printKvittering() {
        window.print();
        return true;
    }
</script>
