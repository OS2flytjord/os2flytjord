    function getTransportoerFiltreringsparametre() {
        //var filtrering = $("#ddlTransportoerFiltreringMetode").val();

        var filteringAlle = $('#chkTransportoerAlle').is(':checked');
        var filteringTidligere = $('#chkTransportoerTidligereAnvendte').is(':checked');

        var filtrering = "1";

        if (filteringAlle) {
            filtrering = $('#chkTransportoerAlle').val();
        } else if (filteringTidligere) {
            filtrering = $('#chkTransportoerTidligereAnvendte').val();
        }

        return { filtreringMetode: filtrering };
    }

    function getModtagerAnlaegFiltreringsparametre() {
        var filteringAlle = $('#chkModtagerAnlaegAlle').is(':checked');
        var filteringTidligere = $('#chkModtagerAnlaegTidligereAnvendte').is(':checked');

        var filtrering = "1";
        if (filteringAlle) {
            filtrering = $('#chkModtagerAnlaegAlle').val();
        } else if (filteringTidligere) {
            filtrering = $('#chkModtagerAnlaegTidligereAnvendte').val();
        }

        //var filtrering = $("#ddlModtagerAnlaegFiltreringMetode").val();
        var chk = $("#chkModtagerAnlaegAnvenderJf");
        var bolAnvenderJf = $(chk).prop("checked");

        var jkt = "";
        if ($("#hflJordKlassifikationType") !== undefined) {
            if ($("#hflJordKlassifikationType").val() !== undefined) {
                jkt = $("#hflJordKlassifikationType").val();
            }
        }
        if (jkt == '' | jkt == '00000000-0000-0000-0000-000000000000') {
            if ($("#hflJordKlassifikationTypeVedAndenOprindelse") !== undefined) {
                if ($("#hflJordKlassifikationTypeVedAndenOprindelse").val() !== undefined) {
                    jkt = $("#hflJordKlassifikationTypeVedAndenOprindelse").val();
                }
            }
        }

        var affaldIJord = $("#rbtAffaldJa").is(':checked');

        var filtParam = {
            filtreringMetode: filtrering,
            wkt: $("#hflOprindelsesstedWkt").val(),
            anvenderJf: bolAnvenderJf,
            jordKlassifikationTypeId: jkt,
            affald: affaldIJord
        };
        return filtParam;
    }

    function openModtagerAnlaegKort(id, modtageranlaegnavn) {
        var wdiv = $("#winModtagerAnlaegKort").kendoWindow({
            iframe: true,
            content: "/ModtagerAnlaeg/Kort?modtagerAnlaegId=" + id,
            type: "GET",
            height: 600,
            width: 900
        });
        wdiv.data("kendoWindow").title(modtageranlaegnavn);
        wdiv.data("kendoWindow").center();
        wdiv.data("kendoWindow").open();
    }

