@using Kendo.Mvc.UI.Fluent
@using Niras.Jordflytning.ViewModels.Anmeldelse
@model OpretModel

@{
    var erNy = !(Model.Anmeldelse != null && Model.Anmeldelse.Id != Guid.Empty);
    var harMidlertidigModtager = (Model.Anmeldelse != null && Model.Anmeldelse.ModtagerAnlaeg != null && Model.Anmeldelse.ModtagerAnlaeg.AnmelderOprettetMidlertidigtAnlaeg);
}

<style>
    #winRedigerMidlertidigtAnlaeg {
        overflow: hidden !important;
    }
</style>

<script type="text/javascript">

    /* Lyt på window messaging, for at fange beskeder fra f.eks. opdateringer i et modal / iframe vindue */
    if (window.addEventListener) {
        window.addEventListener("message", receiveMessage, false);
    } else {
        window.attachEvent("onmessage", receiveMessage, false);
    };

    function receiveMessage(event) {
        var data = event.data;
        if (event.data && event.data.command)
        {
            switch (event.data.command) {
                case "anvendMidlertidigModtager":
                    anvendMidlertidigModtager(event.data);
                    break;
            }
        };
    };

    function anvendMidlertidigModtager(data) {
        /* Opdater med nyt id, gem og gennemtving en reload af siden */
        var anlaegId = data["anlaegId"];
        var dialog = $("#winRedigerMidlertidigtAnlaeg").data("kendoWindow");
        setTimeout(function () { dialog.close(); }, 1);
        $("#hflSelectedModtagerAnlaegId").val(anlaegId);
        if (@(harMidlertidigModtager ? "true" : "false")) {
            midlertidigtModtagerAnlaegAendret(anlaegId);
        } else {
            var form = $("#anmeldelseForm").first("form");
            form.one("submit",
                function () {
                    $(document).one("ajaxComplete", function (event, xhr, settings) {
                        if (@erNy.ToString().ToLower()) {
                            var anmeldelseId = $("#hflAnmeldelseId").val();
                            window.location.replace('@Url.Action("Rediger", "Anmeldelser")?anmeldelseId='+anmeldelseId+'&tab=modtager-transportoer');
                        } else {
                            Jordflytning.url.setParameter('tab', 'modtager-transportoer', true);
                        };
                    });
                    return true;
                });
            $("#btnGem").click();
        };
    };

</script>

<div class="controlsbox row" style="margin-top: 10px; width: 1003px">
  <div class="cbheader">
    <h5>Modtager</h5>
  </div>
  <div class="row_control" style="padding-left: 10px; padding-right: 10px; padding-bottom: 10px;">
      <div style="clear: both"></div>
      <div class="row_line">
          <p><b>Valgt modtageanlæg</b></p>
      </div>
      <div style="clear: both"></div>
      <div class="row_line">
          @(Html.Kendo().Grid(Model.SelectedModtagerAnlaeg)
                      .Name("ValgtJordmodtagerGrid")
                      .HtmlAttributes(new { style = "font-size:12px; min-height: 60px;" })
                      .Events(e => e.DataBound("dataBound"))
                      .Selectable()
                      .DataSource(da => da.Ajax().Model(model => model.Id(p => p.Id)))
                      .Columns(columns =>
                      {
                          columns.Bound(p => p.Id).Hidden();
                          columns.Bound(p => p.Navn).Sortable(true);
                          columns.Bound(p => p.Postnummer).Sortable(true).Title("Postnr.");
                          columns.Bound(p => p.By).Sortable(true).Title("By");
                          columns.Bound(p => p.Afstand).Sortable(true);
                          columns.Bound(p => p.Forureningskategori).Sortable(true);
                          columns.Bound(p => p.Affald).Sortable(true).ClientTemplate("<input disabled='disabled' type='checkbox' #= Affald ? checked='checked' :'' # />");
                          columns.Bound(p => p.JF).Sortable(true).ClientTemplate("<input disabled='disabled' type='checkbox' #= JF ? checked='checked' :'' # />").Title("FlytJord.dk");
                          columns.Bound(p => p.CentraltOprettetMidlertidigtAnlaeg).Sortable(true).ClientTemplate("<input disabled='disabled' type='checkbox' #= CentraltOprettetMidlertidigtAnlaeg || AnmelderOprettetMidlertidigtAnlaeg ? checked='checked' :'' # />").Title("Midlertidigt");
                          columns.Bound(p => p.DocLink).Sortable(false).ClientTemplate("<div style='cursor: pointer;' onclick=\"showDocModalWindow('#= Id #','#= Navn #')\">Vis</div>");
                          columns.Bound(p => p.KortLink).Encoded(false).Title("Kort").Sortable(false);
                          columns.Bound(p => p.www).Encoded(false);
                      })
                          .ClientDetailTemplateId("kontaktTemplate")
          )
      </div>
      <div style="clear: both"></div>

      <br />

      @* Midlertidig modtager anlæg editor - Se scrollbar fix i øverste CSS deklaration! *@
      <script>
          $(document).ready(function() {
              $("#btnOpretMidlertidigtAnlaeg, #btnRedigerMidlertidigtAnlaeg").bind("click",
                  function() {
                      $("#winRedigerMidlertidigtAnlaeg").data("kendoWindow").center().open();
                  });
          });
          var loadMidlertidigAnlaegEditor = function () {
              var dialog = $("#winRedigerMidlertidigtAnlaeg").data("kendoWindow");
              var anlaegId = $("#hflSelectedModtagerAnlaegId").val();
              var jktid;
              var lukDialog = function() {
                  setTimeout(function () { dialog.close(); }, 1);
              };
              var kanGemme = function () {
                  var ok = ($("#divValidering li:visible").length === 0);
                  if (!ok) {
                      setTimeout(function () {
                          dialog.close();
                          alert("Der er et eller flere problemer, som forhindrer at anmeldelsen gemmes.");
                      }, 1);
                  };
                  return ok;
              };
              @if (!erNy)
              {
                  <text>jktid = '@Model.Anmeldelse.Jord.JordKlassifikationTypeId.ToString()';</text>
              }
              else
              {
                  <text>jktid = $("input[name='Anmeldelse.Jord.JordKlassifikationType.Id']:checked").val();</text>
              }
              if (!jktid) {
                  lukDialog();
                  @* Virker ikke ved direkte kald til dialog.close(); *@
                  alert("Du skal først vælge en forureningskategori!");
              } else {
                  if (@(harMidlertidigModtager ? "true" : "false")) {
                      dialog.refresh('@Url.Action("RedigerMidlertidigtBrugerAnlaeg", "ModtagerAnlaeg")/?id=' + anlaegId + '&jordKlassifikationTypeId=' + jktid + "&time=" + new Date().getTime());
                  } else if (confirm("Det er nødvendigt at gemme anmeldelsen først.\nVil du fortsætte?") && kanGemme()) {
                      dialog.refresh('about:blank');
                      var form = $("#anmeldelseForm").first("form");
                      /* Lyt 1 gang på submit, og håndter derefter det færdige ajax kald 1 gang */
                      form.one("submit",
                          function () {
                              if (kanGemme()) {
                                  $(document).one("ajaxComplete", function () {
                                      /* Se efter om der er fejl, ellers er det fint at fortsætte */
                                      if (kanGemme()) {
                                          dialog.refresh('@Url.Action("RedigerMidlertidigtBrugerAnlaeg", "ModtagerAnlaeg")/?id=' + anlaegId + '&jordKlassifikationTypeId=' + jktid + "&time=" + new Date().getTime());
                                      };
                                  });
                              };
                              return true;
                          });
                      $("#btnGem").click();
                  } else {
                      lukDialog();
                  };
              };
          };
      </script>
      
      <div id="modtagerSektion">

          <div class="row_line" style="@((harMidlertidigModtager && !Model.LockButtonGem) ? "" : "display:none;")">
              <div>
                  <input style="width: 175px;" id="btnRedigerMidlertidigtAnlaeg" type="button" name="command" value="Rediger midlertidigt anlæg" />
              </div>
          </div>
      
              <div style="@(harMidlertidigModtager ? "display:none;" : "")">
                  <div class="row_line">
                      <p>Vælg et modtageanlæg</p>
                      <hr>
                      <div class="filtering">
                          @Html.RadioButtonFor(m => m.ModtagerAnlaegFiltrering, "1", new { Id = "chkModtagerAnlaegTidligereAnvendte", Checked = "checked", onchange = "radioModtagerAnlaegFiltreringMetodeSelected();", style = "padding-left: 0px; padding-top: 0px; padding-bottom: 0px;", data_tooltip = "Vis tidligere anvendte" })
                          @Html.Label("lblModtagerAnlaegTidligereAnvendte", "Tidligere anvendte")
                          @Html.RadioButtonFor(m => m.ModtagerAnlaegFiltrering, "4", new { Id = "chkModtagerAnlaegAlle", onchange = "radioModtagerAnlaegFiltreringMetodeSelected();", style = "padding-left: 0px; padding-top: 0px; padding-bottom: 0px;", data_tooltip = "Vis alle" })
                          @Html.Label("lblModtagerAnlaegAlle", "Alle")
                      </div>
                      <div class="filteringFlytJord">
                          @Html.CheckBoxFor(m => m.ModtagerAnlaegFiltreringAnvenderJf, new { Id = "chkModtagerAnlaegAnvenderJf", style = "padding-left: 0px; padding-top: 0px; padding-bottom: 0px;", Checked = "checked", data_tooltip = "Modtageanlæg som anvender FlytJord.dk.<br/>Anvender modtageranlægget FlytJord.dk, er det muligt online at følge afleveret jordmængde." })
                          @Html.Label("lblAnvenderJF2", "Anvender FlytJord.dk")
                      </div>
                      <div>
                          <!--
                          http://demos.telerik.com/aspnet-mvc/window/ajax
                          -->
                          @(Html.Kendo().Window()
          .Name("winRedigerMidlertidigtAnlaeg")
          .Title(string.Format("{0} midlertidigt anlæg", (erNy ? "Opret" : "Rediger")))
          .Content("Vent venligst...")
          .Iframe(true)
          .Scrollable(false)
          .Draggable()
          .Resizable()
          .Width(1024)
          .Height(725)
          .Events(ev => ev.Open("loadMidlertidigAnlaegEditor"))
                                )
                          <input style="margin-left: 50px; width: 175px;@(Model.LockButtonGem ? " cursor: not-allowed;" : "")" id="btnOpretMidlertidigtAnlaeg"@(Model.LockButtonGem ? " disabled='disabled'" : "") type="button" name="command" value="Opret midlertidigt anlæg" />
                      </div>
                  </div>
                  <div style="clear: both"></div>
                  <div class="row_line">
                      @(Html.Kendo().Grid<ModtagerAnlaegModel>()
          .Name("GridMineJordmodtagere")
          .HtmlAttributes(new { style = "font-size:12px;" })
          .Columns(columns =>
          {
              columns.Bound(p => p.Id).Hidden();
              columns.Bound(p => p.Navn).Sortable(true);
              columns.Bound(p => p.Postnummer).Sortable(true).Title("Postnr.");
              columns.Bound(p => p.By).Sortable(true).Title("By");
              columns.Bound(p => p.Afstand).Sortable(true);
              columns.Bound(p => p.Forureningskategori).Sortable(true);
              columns.Bound(p => p.Affald).Sortable(true).ClientTemplate("<input disabled='disabled' type='checkbox' #= Affald ? checked='checked' :'' # />");
              columns.Bound(p => p.JF).Sortable(true).ClientTemplate("<input disabled='disabled' type='checkbox' #= JF ? checked='checked' :'' # />").Title("FlytJord.dk");
              columns.Bound(p => p.CentraltOprettetMidlertidigtAnlaeg).Sortable(true).ClientTemplate("<input disabled='disabled' type='checkbox' #= CentraltOprettetMidlertidigtAnlaeg ? checked='checked' :'' # />").Title("Midlertidigt");
              columns.Bound(p => p.DocLink).Sortable(false).ClientTemplate("<div style='cursor: pointer;' onclick=\"showDocModalWindow('#= Id #','#= Navn #')\">Vis</div>");
              columns.Bound(p => p.KortLink).Encoded(false).Title("Kort").Sortable(false);
              columns.Bound(p => p.www).Encoded(false);
          }
          )
          .Pageable(pager => pager.PageSizes(new[] { 5, 10, 20, 100 })) // Default page sizes are 5, 10 and 20
          .Selectable(selectable => selectable.Mode(GridSelectionMode.Single))
          .Pageable()
          .Sortable()
          .AutoBind(false)
          .DataSource(dataSource => dataSource
              .Ajax() // Specify that the data source is of ajax type
              .Read(read => read.Action("ReadModtagerAnlaeg", "Anmeldelser").Data("getModtagerAnlaegFiltreringsparametre")) // Specify the action method and controller name
              .Model(model => model.Id(p => p.Id))
              .PageSize(100))
          .Events(e => e.Change("modtagerAnlaegSelected").DataBound("gridMineJordmodtagereHover"))
                            )
                  </div>
              </div>
          </div>
      </div>
</div>

