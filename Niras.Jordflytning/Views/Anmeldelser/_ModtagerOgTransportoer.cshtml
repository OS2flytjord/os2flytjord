<script type="text/javascript">

    //////////////////////////////////////////// START KORTINFO API ///////////////////////////////////////////////////

    var mapModtagere;
    function mapInitModtagere(site, page) {
        mapModtagere = new window.KortInfo.Instance(site, page);
        mapModtagere.setUrlArg('westpanel', 'collapse');
        mapModtagere.initializeNested(document.getElementById('divMapModtagere'));
    }

    function mapModtagereNavigateToBbox(lx, ly, ux, uy) {
        mapModtagere.Map.navigateToArea(new window.KortInfo.Geometry.Rectangle2(lx, ly, ux, uy), false);
    }

    //////////////////////////////////////////// SLUT KORTINFO API ////////////////////////////////////////////////////

    function isModtagerTransportoerLocked() {
        // Hvis fanen Modtager og Transportør er låst, må man ikke vælge en ny modtager eller transportør, medmindre at der er tale om en revision
        if ($("#hflRevision").val() == "True")
            return false;
        if ($("#hflLockModtagerTransportoer").val() == "True")
            return true;
        return false;
    }

    function transportoerSelected() {
        var currentSelectedItem = this.dataItem(this.select());
        if (currentSelectedItem.Id != null & !isModtagerTransportoerLocked()) {
            var grid = $("#ValgtTransportoer").data("kendoGrid");
            var id = $("#hflSelectedTransportoerId").val();
            if (id != '') {
                //Fjern eksisterende række
                var data = grid.dataSource.at(0);
                grid.dataSource.remove(data);
            }
            $("#hflSelectedTransportoerId").val(currentSelectedItem.Id);
            //Opdater valg betaler, hvis transportør er sat til betaler.
            window.updateValgtTransportoerBetaler();
            //Tilføj række til øverste grid
            grid.dataSource.add({
                Id: currentSelectedItem.Id,
                Email: currentSelectedItem.Email,
                Navn: currentSelectedItem.Navn,
                Adresse: currentSelectedItem.Adresse,
                Firma: currentSelectedItem.Firma,
                PostNr: currentSelectedItem.PostNr,
                Telefon: currentSelectedItem.Telefon,
                Kontakt: currentSelectedItem.Kontakt,
                Mobiltelefon: currentSelectedItem.Mobiltelefon
            });
        }
    }

    $("#btnVaelgUkendtTransportoer").bind("click", function () {
        if (!isModtagerTransportoerLocked()) {
            var ukendt = @Html.Raw(Json.Encode(Model.UkendtTransportoer));
            var grid = $("#ValgtTransportoer").data("kendoGrid");
            var id = $("#hflSelectedTransportoerId").val();
            if (id != '') {
                //Fjern eksisterende række
                var data = grid.dataSource.at(0);
                grid.dataSource.remove(data);
            }
            $("#hflSelectedTransportoerId").val(ukendt.Id);
            //Opdater valgt betaler, hvis transportør er sat til betaler.
            window.updateValgtTransportoerBetaler();
            //Tilføj række til øverste grid
            grid.dataSource.add({
                Id: ukendt.Id,
                Email: ukendt.Email,
                Navn: ukendt.Navn,
                Adresse: ukendt.Adresse,
                Firma: ukendt.Firma,
                PostNr: ukendt.PostNr,
                Telefon: ukendt.Telefon,
                Kontakt: ukendt.Kontakt,
                Mobiltelefon: ukendt.Mobiltelefon
            });
        }
    });

