<script type="text/javascript">
    var fixTemplateText = function (txt) {
        if (!txt || txt == null || txt == '')
            return '&nbsp;';
        return txt;
    };


    var fixMidlertidigtAnlaegText = function (txt) {
        if (!txt || txt == null || txt == '')
            return '&nbsp;';
        return "MIDLERTIDIGT ANLÆG";
    };
</script>

<script id="kontaktTemplate" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
              items.Add().Text("Kontaktperson").Content(
                  "<div class='employee-details'>" +
                      "<ul>" +
                           "<li><label class='employee-details-label'></label>#= fixMidlertidigtAnlaegText(AnmelderOprettetMidlertidigtAnlaeg) #</li>" +
                          "<li><label class='employee-details-label'>Navn:</label>#= KontaktpersonNavn #</li>" +
                          "<li><label class='employee-details-label'>Telefon:</label>#= KontaktpersonTlf #</li>" +
                          "<li><label class='employee-details-label'>Email:</label>#= KontaktpersonEmail #</li>" +
                      "</ul>" +
                  "</div>"
              );
              items.Add().Text("Adresse").Content(
                "<div class='employee-details'>" +
                    "<ul>" +
                        "<li><label class='employee-details-label'>Adresse:</label>#= fixTemplateText(Adresse) #</li>" +
                        "<li><label class='employee-details-label'>By:</label>#= fixTemplateText(By) #</li>" +
                        "<li><label class='employee-details-label'>Postnummer:</label>#= fixTemplateText(Postnummer) #</li>" +
                    "</ul>" +
                "</div>"
              );
              items.Add().Text("Matrikler").Content(
                "<div class='employee-details'>" +
                    "<ul>" +
                        "<li><label class='employee-details-label'>Ejerlav:</label>#= fixTemplateText(Ejerlav) #</li>" +
                        "<li><label class='employee-details-label'>Ejerlavsnavn:</label>#= fixTemplateText(Ejerlavsnavn) #</li>" +
                        "<li><label class='employee-details-label'>Matrikelnummer:</label>#= fixTemplateText(Matrikelnr) #</li>" +
                        "<li><label class='employee-details-label'>ESR Ejendomsnummer:</label>#= fixTemplateText(EsrEjendomsnummer) #</li>" +
                    "</ul>" +
                "</div>"
                );
            })
            .ToClientTemplate())
</script>

<script>

    function gridMineJordmodtagereHover() {
        $("#GridMineJordmodtagere tbody tr").hover(
            function () {
                $(this).toggleClass("k-state-hover");
            }
        );
    }

    function gridTransportoereHover() {
        $("#GridTransportoere tbody tr").hover(
            function () {
                $(this).toggleClass("k-state-hover");
            }
        );
    }

    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }

</script>

