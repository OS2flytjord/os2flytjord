<div id="contentTabs">
	@(Html.Kendo().TabStrip()
							.Name("contentTabstrip")
							.Items(items =>
											{
												items.Add().Text("Forside").Selected(false).Visible(false);
											})
)
</div>
<script type="text/javascript">
	var tabStrip;

	function selectMenuItem(e) {
		var link = $(e.item).find("> .k-link");
		if (link != null && link.attr("href") != null) {
			e.preventDefault();
			addTab(link.text(), link.attr("href"));
		}
	}

	function addTab(text, url) {
		//var tabStrip = $("#contentTabstrip").data("kendoTabStrip");
		var tabHeader = "<span>" + text + "</span><span class=\"closeTabIcon\" onclick='tabStrip.remove($(this).closest(\"li\"));selectTab()'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>"
		tabStrip.append(
				[/*{
					text: "Item 1",
					url: "http://www.kendoui.com"               // Link URL if navigation is needed, optional.
				},
				{
					text: "<b>Item 2</b>",
					encoded: false,                             // Allows use of HTML for item text
					content: "text"                             // Content for the content element
				},*/
				{
					text: tabHeader,
					encoded: false,
					//contentUrl: url,
					//selected: true
					content: "<iframe src=\"" + url + "\" width=\"100%\" height=\"100%\" border=\"0\" style=\"border:none\"></iframe>"
				}/*,
				{
					text: "Item 4",
					imageUrl: "http://www.kendoui.com/test.jpg" // Item image URL, optional.
				},
				{
					text: "Item 5",
					spriteCssClass: "imageClass3"               // Item image sprite CSS class, optional.
				}*/]
		);

		setTabContentHeight();

		// select the tab
		selectTab();
		//attachTabCloseHandlers();
	}

	function setTabContentHeight() {
		var tabContentHeight = $("#contentTabs").outerHeight();
		$("div[id^='contentTabstrip-']").each(function (index) {
			$(this).css("height", tabContentHeight - 50);
		});
	}

	function attachTabCloseHandlers() {
		$(".closeTabIcon").each(function (i, obj) {
			$(obj).off("click");
			$(obj).click(function (obj) {
				alert($(obj).html);
				//var tabStrip = $("#contentTabstrip").data("kendoTabStrip");
				alert("Idx to close: " + $(obj).closest("li").index());
				tabStrip.remove($(obj).closest("li").index());
				//selectTab();
			});
		});
	}

	function selectTab(index) {
		//var tabStrip = $("#contentTabstrip").data("kendoTabStrip");
		if (!index) { // no index specified -> select last tab
			index = tabStrip.tabGroup.children("li").length - 1;
		}

		if (index >= 0) {
			tab = tabStrip.tabGroup.children("li").eq(index);
			if (tab) {
				tabStrip.select(tab);
			}
		}
	}

	$(document).ready(function () {
		tabStrip = $("#contentTabstrip").data("kendoTabStrip");
	});



</script>
