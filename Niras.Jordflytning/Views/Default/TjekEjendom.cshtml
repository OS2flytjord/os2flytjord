@model Niras.Jordflytning.ViewModels.Anmeldelse.OpretModel

@{
  ViewBag.Title = "Tjek Ejendom";
  Layout = "~/Views/Shared/_LayoutTjekEjendom.cshtml";
}
@section Scripts{
  <script src='@(Model.KortApiUrl)' type='text/javascript'></script>
  <script src="~/Scripts/Map/MapSted.js" type="text/javascript"></script>

  <script type="text/javascript">

    $(document).ready(function () {
      $("#toolbar").hide();

      var kiSite = '@(Model.KortSite)';
      var kiPageSted = '@(Model.KortPageSted)';

      mapInitSted(kiSite, kiPageSted);

      $("#imgSignaturForklaringColapse").click(function () {
        $("#imgSignaturForklaringExpand").show();
        $("#imgSignaturForklaringColapse").hide();
        $("#imgSignaturForklaring").addClass("hideSignaturForklaring");
      });

      $("#imgSignaturForklaringExpand").click(function () {
        $("#imgSignaturForklaringExpand").hide();
        $("#imgSignaturForklaringColapse").show();
        $("#imgSignaturForklaring").removeClass("hideSignaturForklaring");
      });

      $("#imgMaximise").click(function () {
        //Gemmer venstre kolonne.
        $("#divStedLeft").hide();
        $("#divStedHelpMap").hide();

        $("#divStedRight").css('width', '995px');
        $("#divMapSted").css('height', '600px');

        //Signaturforklaring placering ved max kort
        $("#imgSignatur").addClass("maxMapSignatur");
        $("#imgSignaturForklaring").addClass("maxMapSignaturForklaring");
        $("#imgSignaturForklaringExpand").addClass("maxMapSignaturForklaringColapseExpand");
        $("#imgSignaturForklaringColapse").addClass("maxMapSignaturForklaringColapseExpand");


        $("#imgMaximise").toggle();
        $("#imgMinimise").toggle();
      });
      $("#imgMinimise").click(function () {
        //Viser venstre kolonne.
        $("#divStedLeft").show();
        $("#divStedHelpMap").show();

        $("#divStedRight").css('width', '500px');
        $("#divMapSted").css('height', '450px');

        //Signaturforklaring placering ved min kort
        $("#imgSignatur").removeClass("maxMapSignatur");
        $("#imgSignaturForklaring").removeClass("maxMapSignaturForklaring");
        $("#imgSignaturForklaringExpand").removeClass("maxMapSignaturForklaringColapseExpand");
        $("#imgSignaturForklaringColapse").removeClass("maxMapSignaturForklaringColapseExpand");


        $("#imgMaximise").toggle();
        $("#imgMinimise").toggle();
      });


      $("#btnStedNyEjendom").click(function (e) {
        e.preventDefault();
        $("#divEjendomAdresseEdit").show();
        $("#divOffvejAdresseEdit").show();
        $("#divAdresseView").hide();
      });

      $("#btnStedSoegEksterneSystemer").click(function (e) {
        e.preventDefault();
        $("#divStedJordforureningOpslag").show();
        getJordForurening();
        $("#hvadvildunu").show();
      });

      $("#stedTypeEjendom").click(function () {
        $("#divEjendom").show();
        $("#divOffentligVej").hide();
        $("#divAndenOprindelse").hide();
        $("#vejnavnAutoComplete").focus();
        $("#btnStedNyEjendom").click();
      });

      $("#stedTypeOffentligVej").click(function () {
        $("#divEjendom").hide();
        $("#divOffentligVej").show();
        $("#divAndenOprindelse").hide();
        $("#vejnavnOpslag").focus();
        $("#btnStedNyEjendom").click();
      });

      $("#stedTypeAndenOprindelse").click(function () {
        $("#divEjendom").hide();
        $("#divOffentligVej").hide();
        $("#divAndenOprindelse").show();
        $("#btnStedNyEjendom").click();
      });



    });

    function adresseFundet(adr) {
      $("#divEjendomAdresseEdit").hide();
      $("#divOffvejAdresseEdit").hide();
      $("#divAdresseView").show();
      $("#divTegn").show();

      //Kort
      mapSted.setReadyListener(function () {
        if (adr.x != null) {
          mapStedNavigateToBbox(Math.round(adr.x) - 50, Math.round(adr.y) - 50, Math.round(adr.x) + 50, Math.round(adr.y) + 50);
          $("#MapStedLx").val(Math.round(adr.x) - 50);
          $("#MapStedLy").val(Math.round(adr.y) - 50);
          $("#MapStedUx").val(Math.round(adr.x) + 50);
          $("#MapStedUy").val(Math.round(adr.y) + 50);
          $("#hflOprindelsesstedWkt").val("POINT(" + Math.round(adr.x) + " " + Math.round(adr.y) + ")");
        }
      });

      mapStedRedlineWkt($("#hflOprindelsesstedWkt").val());

      $("#hflAdresse").val(adr.vejnavn + " " + adr.husnr);
      $("#txtAdresse").val(adr.vejnavn + " " + adr.husnr);
      $("#txtKommune").val(adr.kommunenavn);
      $("#hflPostDistrikt").val(adr.postdistrikt);
      $("#hflPostnummer").val(adr.postnummer);
      $("#txtPostDistrikt").val(adr.postdistrikt);
      $("#txtPostnummer").val(adr.postnummer);

      getJordForurening();

      $("#divStedJordforureningOpslag").show();
      $("#hvadvildunu").show();
    }


    function getJordForurening() {
      //Nulstil resultat
      $("#labelResultatJord").empty();
      $("#divResultat").empty();
      $("#labelResultatJord").html("Der foretages opslag i eksterne systemer. Vent venligst.");
      $("#resultatJordProgress").show();
      $("#btnKvittering").hide();
      $("#hvadvildunu").hide();

      $.post("@Url.Action("GetJordForurening", "Anmeldelser")", $("#formTjekDinJord").serialize(), function (result) {
        if (result) {
          $("#divStedJordforureningOpslag").html(result); //Erstatter alt inde for div'en med det partial view som man ved GetJordForurening
          $("#resultatJordProgress").hide();
          $("#labelResultatJord").empty();
          $("#divResultatPrint").empty();
          $("#btnKvittering").show();
          $("#hvadvildunu").show();


          var forureningOpslagFejlbesked = $("#hflForureningOpslagFejlbesked").val();
          var forureningOpslagKraeverAnmeldelse = $("#hflForureningOpslagKraeverAnmeldelse").val();
          var forureningOpslagResultat = $("#hflForureningOpslagResultatList").val();

          //Fejl
          if (forureningOpslagFejlbesked != "") {
                alert(@Model.ForureningOpslagFejlbesked);
          } else {

            //Kræver Anmeldelse?
            if (forureningOpslagKraeverAnmeldelse == "True") {
              $("#btnTilJorden").show();
              $("#btnTilJorden").val("Gå til opret anmeldelse");


              $("#btnTilModtager").hide();
              $("#btnTilJorden").click(function () {
                window.location.href = '../Anmeldelser/Opret';
              });
            } else {
              $("#btnTilJorden").hide();
              $("#btnTilModtager").show();
              $("#btnTilModtager").click(function () {
                window.location.href = '../Anmeldelser/Opret';
              });
            }

            $("#btnKvittering").click(function (e) {
              e.preventDefault();
              window.open("/Default/Kvittering", "_blank");
            });

            //Resultat af opslaget
            $("#labelResultatJord").html(forureningOpslagResultat);
            $("#divResultatPrint").html(forureningOpslagResultat);

            //Redliner matriklerne
            mapStedRedlineMatrikelWkt($("#hflMatrikelWkt").val());
          }
        }
      });
    }

    function adresseNulstil() {
      $("#resultatJord").hide();
      $("#hvadvildunu").hide();

      $("#tab_2").attr("disabled", "disabled");
      $("#tab_3").attr("disabled", "disabled");
      $("#tab_4").attr("disabled", "disabled");
      $("#tab_5").attr("disabled", "disabled");
    }
  </script>
}

@section BreadCrumb{
- TJEK EJENDOM 
}


<section id="anmeldelseForm">
  @using (Html.BeginForm("FrontPage", "Default", FormMethod.Get, new { Id = "formTjekDinJord" }))
  {
    @Html.AntiForgeryToken()
    <div id="divSted" class="row" style="margin-top: 10px">

      <div class="column" id="divStedLeft" style="width: 49%">
        <div id="oprindelsessted" class="controlsbox row">
          <div class="cbheader">
            <h5>Oprindelsessted</h5>
          </div>
          <div class="row_control">
            <div class="row" style="display: block">
              <div id="divEjendom">
                <div id="divEjendomAdresseEdit" style="display: @(Model.AdresseOpslagViewMode == false ? "block" : "none")">
                  <div class="row_line">
                    @Html.Partial("~/Views/Anmeldelser/_AdresseOpslag.cshtml")
                  </div>
                  <div style="clear: both"></div>
                </div>
              </div>
            </div>
            <div id="divAdresseView" style="display: @(Model.AdresseOpslagViewMode ? "block" : "none")">@*style="display: none"*@
              <div class="row_line">
                @Html.Label("Adresse")
                @Html.TextBoxFor(m => m.Anmeldelse.Oprindelsessted.Adresse, new { Id = "txtAdresse", @class = "readonly", @readonly = true })
              </div>
              <div class="row_line">
                @Html.Label("Postnummer")
                @Html.TextBoxFor(m => m.Anmeldelse.Oprindelsessted.Postnummer, new { Id = "txtPostnummer", @class = "readonly", @readonly = true, @style = "width:30px;margin-right:10px;" })
                @Html.TextBoxFor(m => m.Anmeldelse.Oprindelsessted.PostDistrikt, new { Id = "txtPostDistrikt", @class = "readonly", @readonly = true, @style = "width:154px" })
              </div>
              <div class="row_line">
                @Html.Label("Kommune")
                @Html.TextBoxFor(x => x.Anmeldelse.Kommune.Navn, new { id = "txtKommune", @class = "readonly", @readonly = true })
              </div>
              <div class="row">
                <label>Udpeg i kort</label>
                <input type="button" id="btnEjendomMapDigPolygon" value="Tegn" onclick=" mapStedDigitaliser() " />
              </div>
                <div style="clear: both"></div>
             
                  <div class="row">
                      <label>Nyt sted</label>
                      <input type="button" value="Vælg" id="btnStedNyEjendom" />
                  </div>
              
            </div>
          </div>
          <div style="clear: both"></div>
        </div>
        <div id="divStedJordforureningOpslag" class="row" style="margin-top: 10px; display: none">
          @Html.Partial("~/Views/Anmeldelser/_stedJordforuningopslag.cshtml", Model)
        </div>
      </div>

      <div id="divStedRight" class="column" style="width: 500px; margin-left: 10px; margin-top:-3px;">
        <div class="row" id="stedRight" style="height: 447px">
          <div style="border: solid 0 #000; height: 100%; width: 100%;" id="divMapContainer">
            <div class="row">
              <div id="divMapSted" class="kiMap" style="width: 100%; height: 450px">
                <div id="divMapMinMax">
                  <img id="imgMinimise" src="/Content/images/cross.png" title="Skift til lille kort" style="display: none;">
                  <img id="imgMaximise" src="/Content/images/application_side_contract.png" title="Skift til stort kort">
                </div>
                <div id="divMapSignatur">
                  <img id="imgSignatur" src="/Content/images/Signatur.png" title="" />
                  <img id="imgSignaturForklaring" src="/Content/images/Signaturforklaring_FJ_small.png" title="" />
                  <img id="imgSignaturForklaringExpand" src="/Content/images/Pil_ned.png" title="Udvid signaturforklaring" />
                  <img id="imgSignaturForklaringColapse" src="/Content/images/Pil_op.png" title="Minimer signaturforklaring" />
                  
                </div>
              </div>
              @*<img id="imgMinimise" src="/Content/images/cross.png" title="Skift til lille kort" style="display: none;">
              <img id="imgMaximise" src="/Content/images/application_side_contract.png" title="Skift til stort kort">
              <img id="imgSignatur" src="/Content/images/Signatur.png" title="" />
              <img id="imgSignaturForklaringExpand" src="/Content/images/Pil_ned.png" title="Udvid signaturforklaring" />
              <img id="imgSignaturForklaringColapse" src="/Content/images/Pil_op.png" title="Minimer signaturforklaring" />
              <img id="imgSignaturForklaring" src="/Content/images/Signaturforklaring_FJ_small.png" title="" />*@

            </div>

            <div class="row">
            </div>
            @*   <div class="row">
			        <div id="divMapSted" style="width: 100%; height: 450px">
			        </div>
		        </div>*@
          </div>
          <div style="clear: both"></div>
        </div>
        <div id="divStedHelpMap" class="controlsbox row" style="margin-top: 10px">
          <div class="cbheader">
            <h5>Hjælp til søgning i kortet</h5>
          </div>
          <div class="row_control">
            <p>Arealet for den valgte adresse er indtegnet i kortet. </p>
            <p>Vedrører jordflytningen imidlertid et andet areal, skal du indtegne det aktuelle område i kortet, og de eksterne forureningsdata vil blive hentet på ny.</p>
          </div>
          <div style="clear: both"></div>
        </div>
      </div>
    </div>
    <div style="clear: both"></div>

    @Html.HiddenFor(x => x.OprindelsesstedWkt, new { id = "hflOprindelsesstedWkt" })
    @Html.HiddenFor(x => x.Anmeldelse.Oprindelsessted.Postnummer, new { id = "hflPostnummer" })
    @Html.HiddenFor(x => x.Anmeldelse.Oprindelsessted.PostDistrikt, new { id = "hflPostDistrikt" })
    @Html.HiddenFor(x => x.Anmeldelse.Oprindelsessted.Adresse, new { id = "hflAdresse" })

    @Html.HiddenFor(x => x.MapStedLx, new { id = "MapStedLx" })
    @Html.HiddenFor(x => x.MapStedLy, new { id = "MapStedLy" })
    @Html.HiddenFor(x => x.MapStedUx, new { id = "MapStedUx" })
    @Html.HiddenFor(x => x.MapStedUy, new { id = "MapStedUy" })
  }
</section>
