@using Kendo.Mvc.UI
@model Niras.Jordflytning.ViewModels.Bruger.BrugerProfilModel

<script type="text/javascript">

    /// for at default valget her Euro-1s værdi bliver sat på modellen. 
    /// Uden dette vil værdien være tom guid hvis brugeren ikke skifter væk fra default valget i dropdownlisten.
    function editForm(e) {
        e.container.data('kendoWindow').bind('activate', function() {
            $('form:first *:input[type!=hidden]:first').focus();
            $('input:visible:enabled:first').focus();
        });
        e.model.set("MiljoeklasseTypeId", $("#MiljoeklasseTypeId").val());
    }

    function udskrivLastbilId() {
        var currentSelectedItem = this.dataItem(this.select());
        if (currentSelectedItem.Id != null) {
            javascript: window.open('@Url.Action("UdskrivLastbil", "Bruger")' + '/' + currentSelectedItem.Id, '_blank');
            return false;
        }
        return false;
    }    

</script>

<div>
    <div class="controlsbox row" style="margin-top: 5px">
        <div class="cbheader">
            <h5>Transportør</h5>
        </div>
        <div class="cbcontent">
            @(Html.Kendo().Grid(Model.TransportoerModel.MineLastbiler)
                  .Name("GridFiltrering")
                  .HtmlAttributes(new {style="margin-top: 10px; margin-bottom: 10px;"})
                  .Pageable().Events(e => e.Edit("editForm"))
                  .Sortable()
                  .Columns(columns =>
                      {
                          columns.Bound(p => p.Aktiv)
                                 .Title("Aktiv")
                                 .ClientTemplate("<input disabled='disabled' type='checkbox' #= Aktiv ? checked='checked' :'' # />")
                                 .Width(20);
                          columns.Bound(p => p.Nummerplade).Title("Nummerplade").Width(180);
                          columns.Bound(p => p.Fabrikat).Title("Fabrikat").Width(250);
                          columns.ForeignKey(p => p.MiljoeklasseTypeId, Model.MiljoeklasseTyper, "Id", "Navn").Title("Miljøklasse");

													//columns.ForeignKey(b => b.BenefitRecordId, Model.OtherBenefitMappingsByUser, "BenefitRecordId", "BenefitDescriptionText").EditorTemplateName("BenefitDescriptionDropDown").Title("Benefit").Filterable(false);
													//columns.ForeignKey(b => b.AppendixD1ElementId, Model.AppendixD1ElementModels, "AppendixD1ElementId", "AppendixD1ElementName").EditorTemplateName("AppendixD1DropDown").Title("Appendix").Filterable(false);
		
												
                          columns.Command(c =>
                              {
                                  c.Edit().Text("Rediger").UpdateText("Gem").CancelText("Annuller");
                                  c.Destroy().Text("Slet");
								  c.Custom("Udskriv").Text("Udskriv ID kort for køretøj").Click("udskrivLastbilId");
                              });
                      })                          
                  .ToolBar(toolbar => toolbar.Create().Text("Tilføj lastbil"))
                  .Editable(editable => editable.Mode(GridEditMode.PopUp).Window(w => w.Title("Rediger lastbil")))
                  .Selectable()
                  .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Model(model =>
                                                    {
                                                        model.Id(p => p.Id);
                                                        model.Field(p => p.Id).DefaultValue(new Guid()); // Ellers fejler valideringen
                                                        model.Field(p => p.TransportoerId).DefaultValue(new Guid());
                                                    })
                                                .PageSize(500)
                                                .Events(events => events.Error("error_handler"))
                                                .Read(read => read.Action("CustomCommandRead", "Bruger"))
                                                .Create(create => create.Action("CustomCommandCreate", "Bruger"))
                                                .Update(update => update.Action("CustomCommandUpdate", "Bruger"))
                                                .Destroy(destroy => destroy.Action("CustomCommandDestroy", "Bruger")))                                                  
                  )		
        </div>      
    </div>
    <div style="clear: both"></div>   
</div>


