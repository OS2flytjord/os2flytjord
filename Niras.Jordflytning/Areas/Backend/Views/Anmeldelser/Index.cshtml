        }

        if (tabId != null && tabId != '') {
            var found = false;
            var tabStrip = $("#tabStrip").kendoTabStrip().data("kendoTabStrip");
            var items = tabStrip.items();
            for (var i = 0; i < items.length; i++) {
                if (items[i].id == tabId) {
                    $("#tabStrip").data("kendoTabStrip").select(i);
                    found = true;
                    break;
                }
            };
            if (!found) {
                $("#tabStrip").data("kendoTabStrip").select(0); // select first tab
            }           
        }
        else {
            $("#tabStrip").data("kendoTabStrip").select(0); // select first tab
        }

