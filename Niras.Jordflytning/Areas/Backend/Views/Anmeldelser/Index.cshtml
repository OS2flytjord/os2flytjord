                var pnummerv = $("#txtFirmaPnummer").val();
                var beskedv = $("#txtBesked").val();


                $.post("/Anmeldelser/OpretBruger", { fornavn: fornavnv, efternavn: efternavnv, adresse: adressev, postnummer: postnummerv, by: byv, telefon: telefonv, mobiltelefon: mobiltelefonv, firma: firmav, firmaNavn: firmaNavnv, firmaAdresse: firmaAdressev, firmaBy: firmaByv, firmaPostnummer: firmaPostnummerv, cvr: cvrv, ean: eanv, pNummer: pnummerv, brugernavn: email, besked: beskedv }, function (result) {
                    console.log(result);
                    if (result) {

                            if (result != '00000000-0000-0000-0000-000000000000') {
                                $("#txtNyBrugerEmail").val("");
                                $("#nyBrugerFornavn").val("");
                                $("#nyBrugerEfternavn").val("");
                                $("#nyBrugerAdresse").val("");
                                $("#nyBrugerPostnummer").val("");
                                $("#txtnyBrugerBy").val("");
                                $("#nyBrugerTelefon").val("");
                                $("#nyBrugerMobiltelefon").val("");
                                $("#txtFirmanavn").val("");
                                $("#txtFirmaadresse").val("");
                                $("#txtFirmaby").val("");
                                $("#txtFirmapostnummer").val("");
                                $("#txtFirmacvr").val("");
                                $("#txtFirmaean").val("");
                                $("#txtFirmaPnummer").val("");

                                winNyBruger.close();
                                var aid = $("#hflAnmeldelseId").val();
                                $.post("@Url.Action("SendHoerAndenKommune", "Anmeldelser", new { area = "Backend" })",
                  { emne: "", besked: beskedv, modtagerEmail: email, anmeldelseId: aid }, function (res) {
                      if (res) {
                          $("#txtModtagerEmail").val("");
                          $("#txtBesked").val("");
                          $('#chkValiderbruger').prop('checked', false);
                          winHoerAndenKommune.close();

                          alert("Brugeren er oprettet og beskeden er afsendt.");
                      }
                      else {
                          alert('Brugeren er oprettet, men afsendelse af besked fejlede.');
                      }
                  });

                            } else {
                                $("#divNyBrugerStatus").html("Person kunne ikke oprettes! <br/>Kontroller om personen allerede findes i systemet.");
                            }
                        }
                    });

            } else {
                alert("Felter markeret med * SKAL udfyldes.");
            }
        });

        //InitGuid - Efter postback
        setTimeout('$("#grdAnmeldelseForureningskomponentListe").data("kendoGrid").dataSource.read();', 2000); //Henter forureningskomponenter

        //SAGSBEHANDLING

        $("#btnSagsbehandlingSoegEksterneSystemer").click(function(e) {
            e.preventDefault();
            if ($("#hflRightSagsbehandlingReadonly").val() != "True") {
                $("#btnStedSoegEksterneSystemer").click();

                var tabAnmeldelse = $("#tabAnmeldelse");
                if (tabAnmeldelse != null) { //safety check
                    var tabAnmeldelseIndx = tabAnmeldelse.index();
                    $("#tabStrip").data("kendoTabStrip").select(tabAnmeldelseIndx);
                }
                var tabAnmeldelseSted = $("#tabAnmeldelse");
                if (tabAnmeldelseSted != null) { //safety check
                    var tabAnmeldelseStedIndx = tabAnmeldelseSted.index();
                    $("#tabAnmeldelse2").data("kendoTabStrip").select(tabAnmeldelseStedIndx);
                }
            }
        });

        $("#btnOpenModtagerAnlaeg").click(function(e) {
            e.preventDefault();
            openTab('@Model.AnmeldelseModel.Anmeldelse.ModtagerAnlaeg.Jordmodtager.Navn', '/Backend/Administration/SelectJordmodtager?id=@Model.AnmeldelseModel.Anmeldelse.ModtagerAnlaeg.Jordmodtager.Id');
        });

        $("#btnTilfoejForureningskomponent").click(function(e) {
            e.preventDefault();
            var displayName = $("#txtForureningAutoComplete").data("kendoAutoComplete").value();
            if (displayName != '') {
                var aid = $("#hflAnmeldelseId").val();
                $.post("@Url.Action("TilfoejForureningskomponent", "Anmeldelser")", { anmeldelseId: aid, forureningsKomponentTypeAHeadSearch: displayName }, function(result) {
                        if (result) {
                            $("#grdAnmeldelseForureningskomponentListe").data("kendoGrid").dataSource.read();
                            $("#txtForureningAutoComplete").val("");
                        }
                    });
                }
            });

            $("#txtForureningAutoComplete").kendoAutoComplete({
                dataTextField: "DisplayName", // The widget is bound to the "name" field
                dataValueField: "Id",
                minLength: 3,
                placeholder: "Forureningskomponent",
                filter: "contains",
                dataSource: {
                    serverFiltering: true,
                    serverPaging: true,
                    pageSize: 2,
                    transport: {
                        read: "/Backend/Anmeldelser/SearchForureningskomponent",
                        parameterMap: function() {
                            return { wildcard: $("#txtForureningAutoComplete").val() };
                        }
                    }
                }
            });

            $("#txtForureningAutoComplete").keypress(function(e) {
                if (e.keyCode == '13') {
                    e.preventDefault();
                    $("#btnTilfoejForureningskomponent").click();
                    $("#txtForureningAutoComplete").val("");
                }
            });


// *** END Document ready *************************************************************************************************************************

        });

        //VOGNLAES

        function vognlaesLastbilerSelect() {
            $("#hfTransportoer").val($("#transportoere").val()).change();
            $("#hfLastbil").val($("#lastbiler").val()).change();
        }

        function filterTransportoere() {
            return {
                transportoere: $("#transportoere").val()
            };
        }

        //HISTORIK OG KOMMUNIKATION

        function ValidateEmail(mail) {
            var mailformat = /^\w+([\.-]?\w+)*@@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
            if (mail.match(mailformat)) {
                return (true)
            }

            alert("Email-adressen ikke gyldig.")
            return (false)
        }


    function openLog(id) {
        $.post("@Url.Action("ReadLog", "Anmeldelser")", { logId: id }, function(result) {
            if (result) {
                var wdiv = $("#winLog");
                wdiv.html(result);
                wdiv.data("kendoWindow").center();
                wdiv.data("kendoWindow").open();
            }
        });
    }

    function openAdvis(id) {
        $.post("@Url.Action("ReadAdvis", "Anmeldelser")", { advisId: id }, function(result) {
            if (result) {
                var wdiv = $("#winAdvis");
                wdiv.html(result);
                wdiv.data("kendoWindow").center();
                wdiv.data("kendoWindow").open();
            }
        });
    }

    function sendAdvis(id) {
        var aid = $("#hflAnmeldelseId").val();
        if (confirm("Er du sikker på at du vil gensende advis?")) {
            $.post("@Url.Action("GensendeAdvis", "Anmeldelser")", { anmeldelseId: aid, advisId: id }, function(result) {
                var wdiv = $("#winSendAdvis");
                wdiv.html(result);
                wdiv.data("kendoWindow").center();
                wdiv.data("kendoWindow").open();
            });
        }
    }

    function openTab(text, url) {
        if (parent.addTab) {
            parent.addTab(text, url);
        }
    }

    function additionalInfoVognlaes() {
        return {
            anmeldelseId: $("#hflAnmeldelseId").val()
        };
    }

    function additionalInfoStikproeveGrid() {
        return {
            anmeldelseId: $("#hflAnmeldelseId").val()
        };
    }

    function resizeContainerDiv() {
        //resizer div som indeholder tab/iframe så man undgår scrollbar på inde i tabben.
        var iframeParentDiv = window.frameElement ? window.frameElement.parentNode : null;
        var iframeHeight = $(document).height();
        $(iframeParentDiv).height(iframeHeight);
    }


    //Header

    function openAnmeldelse(anmeldelseId) {
        var fanenavn = $("#hflRevisionAfAnmeldelseAdresse").val();
        openTab(fanenavn, '/Backend/Anmeldelser/Index?anmeldelseId=' + anmeldelseId);
    }

    function onFormSuccess() {
        $("#grdJordforureningopslag").data("kendoGrid").dataSource.read();

        //setTimeout('loadHistorikForAnmeldelse()', 1000);
        $("#grdHistorikAnmeldelse").data("kendoGrid").dataSource.read();

        //Header
        var aid = $("#hflAnmeldelseId").val();
        $.post("@Url.Action("GetHeaderForAnmeldelse", "Anmeldelser")", { anmeldelseId: aid }, function(result) {
            if (result) {
                $("#divHeader").html(result); //Erstatter alt inde for div'en med result
            }
        });

        //Sagsbehandlingsfanen
        $.post("@Url.Action("GetStatusForAnmeldelse", "Anmeldelser")", { anmeldelseId: aid }, function(status) {
            if (status) {
                var bsk = status.betalerStatusKode;
                var jsk = status.jordmodtagerStatusKode;
                // selects item if its value is equal to "test" using predicate function
                if (bsk != -1) {
                    $("#drpStatusBetaler").data("kendoDropDownList").value(bsk);
                }
                if (jsk != -1) {
                    $("#drpStatusJordmodtager").data("kendoDropDownList").value(jsk);
                }
            }
        });
        $("#divProgress").hide();
    };

    </script>

}

<div>
