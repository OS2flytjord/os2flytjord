        $("#btnSendHoerAndenKommune").click(function (e) {
            e.preventDefault();
            var modtagerEmail = $("#txtModtagerEmail").val();
            var advisbesked = $("#txtBesked").val();
            var aid = $("#hflAnmeldelseId").val();

            if (ValidateEmail(modtagerEmail)) {


                var available = false;
                    $.ajax({
                        // This is key, otherwise request will be made asynchronously and you won't get your response from the server when needed
                        async: false,
                        type: 'GET',
                        url: '@Url.Action("IsUserIdAvailable", "Validation", new { area = "" })',
                        data: { Email: modtagerEmail }
            })
				// My action is a JsonResult that returns either true or false (no quotes, etc.)
				.done(function (data) {
				    available = data;
				})
				.fail(function () {
				    available = false;
				});

          //Brugeren findes allerede i systemet og vi kan derfor bare sende beskeden.
                if (!available) {

                    $.post("@Url.Action("SendHoerAndenKommune", "Anmeldelser", new { area = "Backend" })",
                    { emne: "", besked: advisbesked, modtagerEmail: modtagerEmail, anmeldelseId: aid }, function (result) {
                        if (result) {
                            $("#txtModtagerEmail").val("");
                            $("#txtBesked").val("");

                            winHoerAndenKommune.close();

                            alert("Beskeden er afsendt.");
                        }
                        else {
                            alert('Fejl');
                        }
                    });
                    //Brugeren findes ikke i systemet og skal derfor oprettes.
                } else {
                    $('#chkValiderbruger').prop('checked', true);
                    $('#checkboxFirma').prop('checked', true);
                    $("#txtNyBrugerEmail").val($("#txtModtagerEmail").val());
                    winNyBruger.open();
                    winNyBruger.visible;
                }

            }
        });


