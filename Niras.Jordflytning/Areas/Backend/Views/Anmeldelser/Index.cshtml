@using Kendo.Mvc.UI
@model Niras.Jordflytning.ViewModels.Backend.SagsbehandlingModel
@{
    ViewBag.Title = "Anmeldelse";
    Layout = "~/Areas/Backend/Views/Shared/_LayoutBackendContent.cshtml";

    var cfg = System.Configuration.ConfigurationManager.AppSettings["GebyrTidsregistreringKommuner"];
    Guid[] gegyrTidsregistreringKommuner;
    if (cfg != null) {
        gegyrTidsregistreringKommuner = cfg
            .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => Guid.Parse(x.Trim()))
            .ToArray();
    }
    else
    {
        gegyrTidsregistreringKommuner = new Guid[] { };
    }

    var visGebyrTidsregistrering = 
        Model != null && 
        Model.AnmeldelseModel != null && 
        Model.AnmeldelseModel.Anmeldelse != null && 
        Model.AnmeldelseModel.Anmeldelse.KommuneId != null &&
        gegyrTidsregistreringKommuner.Contains(Model.AnmeldelseModel.Anmeldelse.KommuneId ?? Guid.Empty);
}

@section Scripts{
    <script src='@(Model.AnmeldelseModel.KortApiUrl)' type='text/javascript'></script>
    <script src="~/Scripts/Map/MapSted.js" type="text/javascript"></script>

    <script></script>

