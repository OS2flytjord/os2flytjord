@using System.ComponentModel.DataAnnotations
@using DocumentFormat.OpenXml.Office2010.ExcelAc
@using Kendo.Mvc.UI
@using Kendo.Mvc.UI.Fluent
@using Niras.Jordflytning.ViewModels.Backend
@model ModtagerAnlaegAdminModel

@{
  ViewBag.Title = "Jordmodtager administration";
  Layout = "~/Areas/Backend/Views/Shared/_LayoutBackendContent.cshtml";
}

@section Scripts{
    <script type="text/javascript">


        /* Lyt på window messaging, for at fange beskeder fra f.eks. opdateringer i et modal / iframe vindue */
        if (window.addEventListener) {
            window.addEventListener("message", receiveMessage, false);
        } else {
            window.attachEvent("onmessage", receiveMessage, false);
        };

        function receiveMessage(event) {
            var data = event.data;
            if (event.data && event.data.command) {
                switch (event.data.command) {
                    case "anvendMatrikelIndtegning":
                    anvendMatrikelIndtegning(event.data.data);
                    break;
                }
            };
        };

        function anvendMatrikelIndtegning(data) {
            // Data er af typen Niras.Jordflytning.ViewModels.Placering.PlaceringsdataModel
            var dialog = $("#winRedigerIndtegnetPlacering").data("kendoWindow");
            setTimeout(function() { dialog.close(); }, 1);
            // Håndter det valgte
            $("#hflModtagerAnlaegWkt2").val(data.Wkt);
            $("#hfEjerlav").val(data.Ejerlav);
            $("#hfEjerlavsnavn").val(data.Ejerlavsnavn);
            $("#hfEsrEjendomsnummer").val(data.EsrEjendomsnummer);
            $("#hfIndtegnedeMatriklerJson").val(JSON.stringify(data.Matrikler));
        };

        $(document).ready(function() {

            //Validering af dansk datoformat
            $.validator.methods.date = function(value, element) {
                return this.optional(element) ||
                (/^\d{1,2}[\/-]\d{1,2}[\/-]\d{4}(\s\d{2}:\d{2}(:\d{2})?)?$/.test(value) &&
                    !/Invalid|NaN/.test(new Date(value.replace("/", "-").split("-")[2],
                        value.replace("/", "-").split("-")[1],
                        value.replace("/", "-").split("-")[0])));
            };

            kendo.culture('da-DK');

            $("#btnTilfoejForureningskomponent").click(function(e) {
                e.preventDefault();
                var displayName = $("#txtForureningAutoComplete").data("kendoAutoComplete").value();
                if (displayName != '') {
                    var modtAnlaegId = $("#hfSelectedModtagerAnlaegId").val();
                    var maxValue = $("#txtMaxValue").val();
                    document.getElementById('txtMaxValue').value = "";
                    document.getElementById('txtForureningAutoComplete').value = "";
                    e.preventDefault();
                    //Read komponent med id
                    $.post("/Administration/AddGraenseVaerdi",
                        { DisplayName: displayName, max: maxValue, modtageAnlaegGuid: modtAnlaegId },
                        function(result) {
                            if (result) {
                                var grid = $("#grdAnmeldelseForureningskomponentListe").data("kendoGrid");
                                //Tilføj række til øverste grid
                                grid.dataSource.add({
                                    Id: result.Id,
                                    Navn: result.Navn,
                                    Max: result.Max,
                                    EnhedNavn: result.Enhed
                                });
                            }
                        });
                }
            });

            $("#txtForureningAutoComplete").kendoAutoComplete({
                dataTextField: "DisplayName", // The widget is bound to the "name" field
                dataValueField: "Id",
                minLength: 1,
                placeholder: "Forureningskomponent",
                filter: "startswith",
                dataSource: {
                    serverFiltering: true,
                    serverPaging: true,
                    pageSize: 2,
                    transport: {
                        read: "/Administration/SearchForureningskomponent",
                        parameterMap: function() {
                            return { wildcard: $("#txtForureningAutoComplete").val() };
                        }
                    }
                }
            });

            $("#txtForureningAutoComplete").keypress(function(e) {
                if (e.keyCode == '13') {
                    e.preventDefault();
                    $("#btnTilfoejForureningskomponent").click();
                    $("#txtForureningAutoComplete").val("");
                }
            });

            $("#btnKortModtagerAnlaeg").click(function(e) {
                e.preventDefault();
                if ($("#chkCentraltOprettetMidlertidigtAnlaeg").is(":checked")) {
                    $("#winRedigerIndtegnetPlacering").data("kendoWindow").center().open();
                    // Load håndteres længere nede
                } else {
                    var maid = $("#hfSelectedModtagerAnlaegId").val();
                    openModtagerAnlaegKort(maid);
                };
            });
            Jordflytning.ui.createModalWindow("winModtagerAnlaegKort", 600, 900, "Modtageanlæggets placering", false);
        });

        function onModtagerAnlaegSelected() {
            var grid = $("#GridModtagerAnlaeg").data("kendoGrid");
            var idJord;
            grid.select().each(function() {
                var dataItem = grid.dataItem($(this));
                idJord = dataItem.Id;
                window.location.href = "@Url.Action("SelectModtagerAnlaeg", "Administration")" + "?id=" + idJord;
            });
        }

        function showOkAlert(data, status, xhr) {
            window.displayMessage('Oplysningerne er gemt');
            if (data && data.redirectTo) {
                location.replace(data.redirectTo);
            }
        }

        function showFailAlert() {
            alert("Der skete en fejl. Prøv igen.");
        }

        function onSuccess() {
            onModtagerAnlaegSelected();
            $("#GridDokumenation").data("kendoGrid").dataSource.read();
        }

        function onError(e) {
            // Array with information about the uploaded files
            if (e.operation == "upload") {
                alert("Filen er for stor!");
            }
        }

        function openModtagerAnlaegKort(id) {
            var handleModalWindowInputs = function() {
                alert("handleModalWindowInputs");
                var wkt = $("#hflModtagerAnlaegWkt").val();
                $("#hflModtagerAnlaegWkt2").val(wkt);
            };
            var wdiv = $("#winModtagerAnlaegKort").kendoWindow({
                iframe: true,
                content: "/ModtagerAnlaeg/RedigerPlacering?modtagerAnlaegId=" + id,
                type: "GET"
            });
            wdiv.data("kendoWindow").center();
            wdiv.data("kendoWindow").open();
        }

        function onSelectedJordAnlaegType(e) {
            var currentSelectedItem = this.dataItem(this.select());
            if (currentSelectedItem != null) {
                var dataItem = this.dataItem(e.item.index());
                $("#hfJordAnlaegTypeId").val(dataItem.Value);
            }
        }

        function onTilfoejAnlaeg() {
            var id = $("#hfSelectedJordModtagerId").val();
            window.location.href = "@Url.Action("CreateModtagerAnlaeg", "Administration")" + "?jordGuid=" + id;
        }

        function onSelectedLandsdelType(e) {
            var currentSelectedItem = this.dataItem(this.select());
            if (currentSelectedItem != null) {
                $("#hfLandsdelTypeId").val(currentSelectedItem.Value);
            }
        }

        function getLandsdelId() {
            var filtParam = {
                landsdelTypeId: $("#drpLandsdel").val()
            };
            return filtParam;
        }

        function gridModtagerAnlaegHover() {
            $("#GridModtagerAnlaeg tbody tr").hover(
                function() {
                    $(this).toggleClass("k-state-hover");
                }
            );
        }

        function PopUpEdit(e) {
            // HIDE READONLY VALUES!
            $(e.container).find('[for="Id"]').parent().hide();
            $(e.container).find('#Id').parent().hide();
            $(e.container).find('#Navn').attr('disabled', 'disabled');
            $(e.container).find('#Navn').addClass('hideTextbox');
            $(e.container).find('[for="Kode"]').parent().hide();
            $(e.container).find('#Kode').parent().hide();
            $(e.container).find('[for="EnhedNavn"]').parent().hide();
            $(e.container).find('#EnhedNavn').parent().hide();
        }

        function startChange() {
            var endPicker = $("#datSlut").data("kendoDatePicker"),
                startDate = this.value();

            if (startDate) {
                startDate = new Date(startDate);
                startDate.setDate(startDate.getDate() + 1);
                endPicker.min(startDate);
            }
        }

        function endChange() {
            var startPicker = $("#datStart").data("kendoDatePicker"),
                endDate = this.value();

            if (endDate) {
                endDate = new Date(endDate);
                endDate.setDate(endDate.getDate() - 1);
                startPicker.max(endDate);
            }
        }
    </script>
}

<style>
    #winRedigerIndtegnetPlacering {
        overflow: hidden !important;
    }
</style>

