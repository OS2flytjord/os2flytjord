                    </div>
                    <div style="clear: both"></div>
                    
                    <div class="row_line">
                        <label>Automatik kommune</label>
                        <label style="width: 260px">@Html.CheckBoxFor(m => m.SelectedModtagerAnlaeg.OphaevAutoGodkendAnmKom, new { style = "margin-left: 0px; margin-right: 5px; margin-top:2px;" })Ingen automatisk godkendelse af anmeldelser</label>
                    </div>

                    <div class="row_line" style="display: @( (Model.SelectedModtagerAnlaeg != null && Model.SelectedModtagerAnlaeg.AnvenderJf) ? "block" : "none")">
                        <label>Automatik jordmodtager</label>
                        <label style="width: 260px">@Html.RadioButtonFor(m => m.SelectedModtagerAnlaeg.AutoGodkend, true, new { name = "rbAccept" })Systemet godkender automatisk visse anmmeldelser</label>
                    </div>
                    <div style="clear: both"></div>
                    
                    <div class="row_line"  style="display: @( (Model.SelectedModtagerAnlaeg != null && Model.SelectedModtagerAnlaeg.AnvenderJf) ? "block" : "none")">
                        <label>&nbsp;</label>
                        <label style="width: 260px">@Html.RadioButtonFor(m => m.SelectedModtagerAnlaeg.AutoGodkend, false, new { name = "rbAccept" })Miljømedarbejder skal altid vurdere anmeldelserne</label>
                    </div>
                    <div style="clear: both"></div>
                    
                    <div class="row_line" >
                        <input id="btnGemAnlaeg" name="command" type="submit" style="margin-top:15px;  margin-left:38%;" value="Gem" />
                    </div>
                    <div style="clear: both"></div>
                </div>      
            }
        </div>

        <div class="column" style="width: 47%; margin-right: 0px; margin-top: 6px; display: @( (Model.SelectedModtagerAnlaeg != null && Model.SelectedModtagerAnlaegGuid != Guid.Empty) ? "block" : "none");">
            <div class="row_line" >
                @(Html.Kendo().Grid<DokumenterViewModel>()
                      .Name("GridDokumenation")
                      .HtmlAttributes(new { style = "font-size:12px;" })
                      .Columns(columns =>
                          {
                              columns.Bound(p => p.Id).Hidden();
                              columns.Bound(p => p.FilNavn).Sortable(true).Title("Dokumenter");
                              columns.Bound(p => p.Id).ClientTemplate(Html.ActionLink("Åben", "DownloadDokumentation",
                                                                                      new
                                                                                          {
                                                                                              modtageAnlaegId = Model.SelectedModtagerAnlaegGuid,
                                                                                              filnavn = "#=FilNavn#",
                                                                                              target = "_blank"
                                                                                          })
                                                                          .ToHtmlString())
                                     .Title("").Width(70);
                              columns.Command(c => c.Destroy().Text("Fjern")).Width(70);
                          }
                      )
                      .Selectable(selectable => selectable.Mode(GridSelectionMode.Single))
                      .Editable(ed => ed.DisplayDeleteConfirmation("Vil du fjerne filen?"))
                      .DataSource(dataSource => dataSource.Ajax() // Specify that the data source is of ajax type
                                                          .Read(read => read.Action("ReadDokumentation", "Administration", new { anlaegGuid = Model.SelectedModtagerAnlaegGuid }))
                                                          .Model(model => model.Id(p => p.Id))
                                                          .Destroy(des => des.Action("RemoveTheDocument", "Administration", new { anlaegGuid = Model.SelectedModtagerAnlaegGuid }))
                      ))        
            </div>
            <div style="clear: both"></div>

            <div style="width: 45%">
                <div>
                    @(Html.Kendo().Upload()
                          .Name("files")
                          .Async(a => a.Save("UploadDocument", "Administration", new { modtageAnlaegGuid = Model.SelectedModtagerAnlaegGuid })
                              .AutoUpload(true))
                          .ShowFileList(false)
                          .Messages(m=>m.Select("Tilføj"))
                          .Events(ev => ev
                              .Success("onSuccess")
                              .Error("onError")
                              ))
                </div>
            </div>
            <div style="clear: both"></div>

            <div class="row_line" style="margin-bottom: 15px; margin-top:25px;">
                @if (Model.SelectedModtagerAnlaeg != null)
                {
                    @(Html.Kendo().Grid(Model.SelectedModtagerAnlaeg.GraenseVaerdierList)
                          .Name("grdAnmeldelseForureningskomponentListe")
                          .HtmlAttributes(new { style = "font-size:12px; max-height: 650px; overflow-y: auto;" })
                          .Events(e => e.Edit("PopUpEdit"))
                          .Columns(columns =>
                              {
                                  columns.Bound(p => p.Id).Hidden();
                                  columns.Bound(p => p.Navn).Title("Forureningskomponent").Width(250);
                                  columns.Bound(p => p.Max).Title("Max");
                                  columns.Bound(p => p.EnhedNavn).Title("Enhed");

                                  columns.Command(command =>
                                  {
                                      command.Edit().Text("Ret").UpdateText("Gem").CancelText("Annuller");
                                      command.Destroy().Text("Fjern");
                                  }).Width(50);
                              })
                              .Editable(editable => editable.Mode(GridEditMode.PopUp).Window( w => w.Title("Ret")))
                          .Editable(ed => ed.DisplayDeleteConfirmation("Vil du fjerne forureningskomponenten?"))
                          .DataSource(dataSource => dataSource
                                                        .Ajax()
                                                        .Model(model => model.Id(p => p.Id))
                                                            .Destroy(destroy => destroy.Action("RemoveGraenseVaerdi", "Administration", new { modtageAnlaegGuid = Model.SelectedModtagerAnlaeg.Id }))
                                                            .Update(update => update.Action("UpdateGraenseVaerdi", "Administration", new { modtageAnlaegGuid = Model.SelectedModtagerAnlaeg.Id }))
                          ))
                }
                
            </div>
            <div class="row_line" style="display: inline; ">
                <input id="txtForureningAutoComplete" style="width: 250px; float: left; border:0px;" />
                <input id="txtMaxValue" maxlength="10" style="height:22px; margin-top: 1px; margin-left: 6px; width: 50px; float: left;" />
                <label style="margin-top: 1px; margin-left: 12px; width:45px; float: left">mg/kg</label>
                <input id="btnTilfoejForureningskomponent" style="float: right; margin-right:0px;" type="button" value="Tilføj" />
            </div>
            <div style="clear: both"></div>
        </div>
        <div style="clear: both"></div>

    </div>
</div>

<div id="winModtagerAnlaegKort" style="display: none">
    @*Modal vindue til visning af modtagerAnlaeget i kortet.*@
</div>