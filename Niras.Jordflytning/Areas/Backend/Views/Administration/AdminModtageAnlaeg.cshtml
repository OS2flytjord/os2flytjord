	</div>

    <div class="column" style="margin-right: 0px; width: 48%;">
        <div class="controlsbox row" style="margin-top: 10px">
            <div class="cbheader">
                <h5>Modtageanlæg</h5>
            </div>
            <div style="clear: both"></div>
            <div class="row_control">
                <div class="row_line">
                    @(Html.Kendo().Grid(Model.ModtagerAnlaegList)
                          .Name("GridModtagerAnlaeg")
                          .HtmlAttributes(new { style = "font-size:12px;" })
                          .Columns(columns =>
                          {
                              columns.Bound(p => p.Id).Hidden();
                              columns.Bound(p => p.Navn).Sortable(true).Title("Navn");
                              columns.Bound(p => p.Adresse).Sortable(true).Title("Adresse");
                              columns.Bound(p => p.Postnummer).Sortable(true).Title("Postnr.");
                              columns.Bound(p => p.By).Sortable(true).Title("By");
                              columns.Bound(p => p.Aktiv).Sortable(true).Title("Aktiv").ClientTemplate("<input disabled='disabled' type='checkbox' #= Aktiv ? checked='checked' :'' # />").Width(20);
                          })
                          .Sortable()
                          .Events(events => events.Change("onModtagerAnlaegSelected").DataBound("gridModtagerAnlaegHover"))
                          .Selectable(selectable => selectable.Mode(GridSelectionMode.Single))
                          .DataSource(dataSource => dataSource
                              .Ajax()
                              .ServerOperation(false)
                              .Model(model => model.Id(p => p.Id)))

                          )
                </div>
            </div>
            <div class="row_line" style="float: left">
                <input type="button" id="btnTilfoejAnlaeg" style="margin-left:10px" value="Opret" onclick="onTilfoejAnlaeg()" />
            </div>
            <div style="clear: both"></div>
        </div>
    </div>
</div>

