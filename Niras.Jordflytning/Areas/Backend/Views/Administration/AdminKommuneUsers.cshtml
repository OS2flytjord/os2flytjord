@section TopMenu {
<div>
	<input type="submit" value="Gem" class="toolbarButton" />
	<input type="submit" value="Annuller" class="toolbarButton" />
</div>
	}



<section id="anmeldelseForm">
	@using (Html.BeginForm())
 {
		@Html.AntiForgeryToken()
		@Html.ValidationSummary(true)
	
 
		<div id="Content" class="tabContent">
			<div class="row">
				<div class="column" id="stedLeft">

					<div class="row">
						@Html.LabelFor(m => m.Fornavn)
						@Html.TextBoxFor(m => m.Fornavn)
					</div>
					<div class="row">
						@Html.LabelFor(m => m.Efternavn)
						@Html.TextBoxFor(m => m.Efternavn)
					</div>

					<div class="row">
						@Html.LabelFor(m => m.Adresse)
						@Html.TextBoxFor(m => m.Adresse)
					</div>

					<div class="row">
						@Html.LabelFor(m => m.Zipcode)
						@Html.TextBoxFor(m => m.Zipcode, new { style = "width:50px;margin-right:10px;" })
						@Html.TextBoxFor(m => m.By, new { style = "width:109px;" })
					</div>
					<div class="row">
						@Html.LabelFor(m => m.Email)
						@Html.TextBoxFor(m => m.Email)
					</div>
					<div class="row">
						@Html.LabelFor(m => m.Adgangskode)
						@Html.TextBoxFor(m => m.Adgangskode)
					</div>

					<div class="row" style="margin-top: 25px">
						@Html.LabelFor(m => m.Aktiv)
						@Html.CheckBoxFor(m => m.Aktiv)
					</div>
					<div class="row" style="margin-top: 25px">
						@Html.LabelFor(m => m.Roller)
					</div>
					<div class="row">
						@Html.LabelFor(m => m.Administrator)
						@Html.CheckBoxFor(m => m.Administrator)
					</div>
					<div class="row">
						@Html.LabelFor(m => m.Sagsbehandler)
						@Html.CheckBoxFor(m => m.Sagsbehandler)
					</div>
					<div class="row">
						@Html.LabelFor(m => m.Underskrift)
						<img src="" />
					</div>
					<div class="row">
						<input type="text" id="inputSignaturePath" />
						<input type="button" id="inputBrowseSignature" value="Browse" />
					</div>
				</div>
				<div class="column" id="stedRight">
					<div class="row">
						<h4>Eksisterende brugere:</h4>
						<table border="1" cellpadding="3">
							<tr>
								<th class="gridheader">Brugere</th>
								<th class="gridheader">Email</th>
								<th class="gridheader">Roller</th>
								<th class="gridheader"></th>
							</tr>
							<tr>
								<td>Jens Jensen</td>
								<td>jj@gmail.com</td>
								<td>Roller</td>
								<td><a>Rediger bruger</a></td>
							</tr>
							<tr>
								<td>Jens Jensen</td>
								<td>jj@gmail.com</td>
								<td>Roller</td>
								<td><a>Rediger bruger</a></td>
							</tr>
							<tr>
								<td>Jens Jensen</td>
								<td>jj@gmail.com</td>
								<td>Roller</td>
								<td><a>Rediger bruger</a></td>
							</tr>
						</table>
</div>
						

