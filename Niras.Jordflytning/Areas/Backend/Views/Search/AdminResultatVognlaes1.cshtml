    if (e.type == "update") {
      if (!e.response.Errors) {
        Logger.log(afvistDatarow);
      } else {

      }
    }

  }

  function GridVognlaesListDataBound() {
    SetHoverOnGrid();

    //Selects all edit buttons
    $("#GridVognlaesSoegeresultater tbody tr .k-grid-edit").each(function () {
      var currentDataItem = $("#GridVognlaesSoegeresultater").data("kendoGrid").dataItem($(this).closest("tr"));

      //Check in the current dataItem if the row is editable
      if (currentDataItem.Afvist == true) {
        $(this).remove();
      }
    });
  }

  function SetHoverOnGrid() {
    $("#GridVognlaesSoegeresultater tbody tr").hover(
     function () {
       $(this).toggleClass("k-state-hover");
     });
  }

  function OpenAnmeldelse() {
    var grid = $("#GridVognlaesSoegeresultater").data("kendoGrid");
    grid.select().each(function () {
      var dataItem = grid.dataItem($(this));
      var id = dataItem.AnmeldelseId;
      var faneNavn = dataItem.Adresse;
      if (parent.addTab) {
        parent.addTab(faneNavn, "/Backend/Anmeldelser/Index?anmeldelseId=" + id);
      }
    });
  }

  function ExportToCsv(gridName, controllerName) {


    var theGrid = $("#" + gridName);
    var theDataSource = theGrid.data("kendoGrid").dataSource;
    var theGridData = theGrid.data("kendoGrid").dataSource.data();


    // Create a datasource for the export data.
    var ds = new kendo.data.DataSource({
      data: theGridData
    });

    ds.query({
      aggregate: theDataSource._aggregate,
      filter: theDataSource._filter,
      sort: theDataSource._sort
    });

    var dataene = JSON.stringify(ds._view);
    // Define the data to be sent to the server to create the csv.
    data = {
      data: dataene,
      title: gridName
    };

    if (dataene != "undefined" & dataene != null & dataene.length > 1900000) {
      //Datamængden er forstår
      alert('Datamængden overskridet det maksimal tilladte!\nOpdel eventuel søgningen flere mindre søgninger.');

    } else {
      
      // Create the csv.
      $.ajax({
        type: "POST",
        url: "/" + controllerName + "/ExportToCsv",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        data: JSON.stringify(data)
      })
          .done(function (e) {
            // Download the csv.
            window.location.href = "/Backend/" + controllerName + "/GetCsvFile?title=" + gridName;
          });
    }
  }

  function getSearchParameters() {
    var vognlaesFoerDato = $("#hflVognlaesFoerDato").val();
    var vognlaesEfterDato = $("#hflVognlaesEfterDato").val();
    var vognlaesReturnType = $("#hflVognlaesReturnType").val();
    return {
      foerDate: vognlaesFoerDato, efterDate: vognlaesEfterDato, udtraekTilOkonimiSystem: vognlaesReturnType
    };
  }


</script>
