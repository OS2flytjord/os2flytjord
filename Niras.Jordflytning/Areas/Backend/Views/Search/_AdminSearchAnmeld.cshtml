@using System.Collections
@using Kendo.Mvc.UI
@model Niras.Jordflytning.Areas.Backend.ViewModels.AdminSoegModel

<div>
    <div class="controlsbox" style="margin-top: 10px; height: auto">
        <div class="cbheader">
            <h5>Søgeparametre</h5> 
        </div>
        <div class="row" style="margin: 10px; width: 90%">
            <div class="row">
                <div class="column">
                    <div class="row_line">
                        @Html.Label("Løbenummer", new { id = "lblLoebenr" })
                        @Html.TextBoxFor(m => m.LoebeNr, new { Id = "loebeNr", style = "width: 78px; margin-top:3px; margin-bottom:3px;" })
                    </div> 
                    <div style="clear: both"></div>
                    <div class="row_line">
                        @Html.Label("Periode", new { id = "lblPeriode" })
                        @(Html.Kendo().DatePickerFor(m => m.EfterDato).HtmlAttributes(new { id = "efterDate", Class="classiclook_kendo_workaround", style = "width:105px" }))      
                        <img src="~/Content/Icons/arrow_right.png" alt="til" title="til" height="20" width="20" style="vertical-align: middle"/>
                        @(Html.Kendo().DatePickerFor(m => m.FoerDato).HtmlAttributes(new { id = "foerDate", Class="classiclook_kendo_workaround", style = "width:105px" }))
                    </div>
                    <div style="clear: both"></div>
                    <div class="row_line">
                        @Html.Label("Oprindelsessted", new { id = "lblOprindelsessted" })
                        @Html.TextBoxFor(m => m.Adresse, new { Id = "adresse", style = "width: 232px; margin-top:3px; margin-bottom:3px;" })
                    </div>
                    <div style="clear: both"></div>
                    <div class="row_line">
                        <label>Inkl. afsluttede</label>
                        @Html.CheckBoxFor(m => m.InclAfsluttede, new { Id = "InclAfsluttede", style = "height:22px; margin-left:0px;" })
                    </div>

                </div>
                <div class="column">
                    <div class="row_line">
                        <label>Modtager</label>
                        @(Html.Kendo().DropDownListFor(m => m.ModtagerId)
                              .OptionLabel("Vælg modtager")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model.ModtagerAnlaegList)
                              .HtmlAttributes(new { style = "width:240px" })
                              )
                    </div>
                    <div class="row_line">
                        <label>Transportør</label>
                        @(Html.Kendo().DropDownListFor(m => m.TransportoerId)
                              .OptionLabel("Vælg transportør")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model.TransportoerList)
                              .HtmlAttributes(new { style = "width:240px" })
                              )
                    </div>
                    <div class="row_line">
                        <label>Anmelder</label>
                        @(Html.Kendo().DropDownListFor(m => m.AnmelderId)
                              .OptionLabel("Vælg anmelder")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model.AnmelderList)
                              .HtmlAttributes(new { style = "width:240px" })
                              )
                    </div>
                    <div class="row_line">
                        <label>Forureningskategori</label>
                        @(Html.Kendo().DropDownListFor(m => m.Forureningskategori)
                              .OptionLabel("Vælg forureningskategori")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model.ForureningskategoriList)
                              .HtmlAttributes(new { style = "width:240px" })
                              )
                    </div>
                    <div class="row_line">
                        <label>Materiale-/jordtype</label>
                        @(Html.Kendo().DropDownListFor(m => m.AndenOprindJordTypeId)
                              .OptionLabel("Vælg materiale-/jordtype")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model.MaterialeList)
                              .HtmlAttributes(new { style = "width:240px" })
                              )
                    </div>
                    <div class="row_line">
                        <label>Anden oprindelse</label>
                        @(
    Html.TextBoxFor(m => m.AndenOprindBeskrivelse, new { placeholder = "Søg i anden oprindelse beskrivelse...", style = "width:240px" })
                              )
                    </div>
                </div>
            </div>
        
            <div class="row_line">&nbsp;</div>

            <div class="row_line">
                <input id="btnSoeg" name="btnSoegAnmeldelse" onclick="onSoegAnmeldelse()" type="submit" value="Søg" class="toolbarButton" />
            </div>
        </div>
        <div style="clear: both"></div>
    </div>
</div>

<script type="text/javascript">
    function keypressHandler(e) {
        if (e.which == 13) {
            e.preventDefault();

            $('#btnSoeg').focus().click();
        }
    }

    $('.controlsbox').keypress(keypressHandler);
</script>