@using Kendo.Mvc.UI
@model Niras.Jordflytning.Areas.Backend.ViewModels.AdminSoegModel

@{
    ViewBag.Title = "Søg";
    Layout = "~/Areas/Backend/Views/Shared/_LayoutBackendContent.cshtml";
}

<script type="text/javascript">


    function GridAktuelleStikproeverListDataBound() {
        $("#GridStikProeveSoegeresultater tbody tr").hover(
         function () {
             $(this).toggleClass("k-state-hover");
         }
     );
    }

    $(document).ready(function () {
        
        $("#GridStikProeveSoegeresultater tbody tr").hover(
            function() {
                $(this).toggleClass("k-state-hover");
            }
        );
    });

    function GridAktuelleStikproeverListOnChange() {
        $("#GridStikProeveSoegeresultater tbody tr").hover(
            function() {
                 $(this).toggleClass("k-state-hover");
            }
        );
        var grid = $("#GridStikProeveSoegeresultater").data("kendoGrid");

        grid.select().each(function () {
            var dataItem = grid.dataItem($(this));
            var id = dataItem.StikproeveId;
            var faneNavn = dataItem.LoebeNummer;
            if (parent.addTab) {
                parent.addTab("Stikprøve: " + faneNavn, "/Backend/Stikproeve/Stikproeve?stikproeveId=" + id);
            }
        });
    }

    function GridSoegeresultateronDataBinding() { }
    
    function ExportToCsv() {
        alert("LAHA: Ikke implementeret endnu.");
    }
    
</script>
<body style="height: 90%;">
    
        <div class="row_line" >
        <div id="divSoegParam" class="controlsbox">
            <div class="cbheader">
                <h5>Søgeparametre</h5>
            </div>
            <div class="row_line" style="margin: 10px;">
                 @Html.DisplayFor(m => m.SoegningBeskrivelseStikProever, new { Id = "soegStikproeveNote", style = "width: 99%" })
            </div>
            <div style="clear: both"></div>
        </div>
    </div>

    <div class="row_line" >
        <div id="divSoegResult" class="controlsbox">
            <div class="cbheader">
                <h5>Søgeresultat stikprøve</h5>
            </div>
            
           <div class="row_line" style="margin: 10px;">              
               <input type="button" value="Exporter til Excel" onclick="ExportToExcel('GridStikProeveSoegeresultater', 'Search')"/>
            </div>
            <div style="clear: both"></div>
            <div class="row_line">

                @(Html.Kendo().Grid(Model.SoegeResultatStikProeveList)
                      .Name("GridStikProeveSoegeresultater")                        
                      .Pageable(pager => pager.PageSizes(true).PageSizes(new []{ 10, 50, 100, 500 }).Messages(x=>x.ItemsPerPage("Rækker pr. side")))
                      .Sortable()                            
                      .Groupable()   
                      .HtmlAttributes(new { style = "font-size:13px;" })  
                      .Selectable(selectable => selectable
                                                    .Mode(GridSelectionMode.Single)
                                                    .Type(GridSelectionType.Row))
                      
                      .Events(events => events
                                            .Change("GridAktuelleStikproeverListOnChange")
                                            .DataBound("GridAktuelleStikproeverListDataBound")
                                            .DataBinding("GridSoegeresultateronDataBinding"))
                          
                      .Columns(columns =>
                          {
                              columns.Bound(a => a.StikproeveId).Hidden(true);
                              columns.Bound(a => a.LoebeNummer).Title("Nr.").Width(100);
                              columns.Bound(a => a.ModtageAnlaegNavn).Title("Modtageanlæg");
                              columns.Bound(a => a.BaasNr).Title("Bås");
                              columns.Bound(a => a.AnmeldelseLoebenr).Title("Anmeldelse lbnr.");
                              columns.Bound(a => a.Adresse).Title("Oprindelsesadresse");
                              columns.Bound(a => a.TransportoerNavn).Title("Transportør");
                              columns.Bound(a => a.Status).Title("Seneste status");
                          })
                      .DataSource(dataSource => dataSource.Ajax()
                                                          .Model(model => model.Id(m => m.StikproeveId))
                                                          .ServerOperation(false)
                                                          .PageSize(100))
    
                      )
            </div>
            <div style="clear: both"></div>
        </div>
    </div>
</body>
