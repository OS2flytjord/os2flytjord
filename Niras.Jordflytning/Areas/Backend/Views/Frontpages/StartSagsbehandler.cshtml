@using Kendo.Mvc.UI
@using Niras.Jordflytning.ViewModels.Backend
@model Niras.Jordflytning.Areas.Backend.ViewModels.StartSagsbehandlerViewModel

@{
    ViewBag.Title = "Kommune administration";
    Layout = "~/Areas/Backend/Views/Shared/_LayoutBackendContent.cshtml";
}

@section Scripts{
    <script type="text/javascript">


        function GridKraeverHandlingListDataBound() {
            $("#GridKraeverHandlingList tbody tr").hover(
             function () {
                 $(this).toggleClass("k-state-hover");
             }
         );
        }

        $(document).ready(function () {
            $("#GridKraeverHandlingList tbody tr").hover(
           function () {
               $(this).toggleClass("k-state-hover");
           }
         );
        });


        function GridKraeverHandlingListOnChange() {
            //$("#GridKraeverHandlingList tbody tr").hover(
            //    function () {
            //        $(this).toggleClass("k-state-hover");
            //    }
            //);
            var grid = $("#GridKraeverHandlingList").data("kendoGrid");
            var id;
            var faneNavn;
            grid.select().each(function () {
                var dataItem = grid.dataItem($(this));
                id = dataItem.AnmeldelseId;
                faneNavn = dataItem.OprindelsesSted;
                if (parent.addTab) {
                    parent.addTab(faneNavn, "/Backend/Anmeldelser/Index?anmeldelseId=" + id);

                }
            });
        }

        function GridMineAnmeldelserListDataBound() {
            $("#GridMineAnmeldelserList tbody tr").hover(
             function () {
                 $(this).toggleClass("k-state-hover");
             }
         );
        }

        $(document).ready(function () {
            $("#GridMineAnmeldelserList tbody tr").hover(
           function () {
               $(this).toggleClass("k-state-hover");
           }
         );


        });

        function GridMineAnmeldelserListOnChange() {
            //$("#GridMineAnmeldelserList tbody tr").hover(
            //    function () {
            //        $(this).toggleClass("k-state-hover");
            //    }
            //);
            var grid = $("#GridMineAnmeldelserList").data("kendoGrid");
            var id;
            var faneNavn;
            grid.select().each(function () {
                var dataItem = grid.dataItem($(this));
                id = dataItem.AnmeldelseId;
                faneNavn = dataItem.OprindelsesSted;
                if (parent.addTab) {
                    parent.addTab(faneNavn, "/Backend/Anmeldelser/Index?anmeldelseId=" + id);
                }
            });
        }

    </script>

}

<div>
    @*<div class="row">
            <h4>Sagsbehandler forside</h4>
        </div>*@

    <div class="row">
        <div class="controlsbox" style="margin-top: 10px">
            <div class="cbheader">
                <h5>Kræver handling</h5>
            </div>
            <div class="row">
                @(Html.Kendo().Grid(Model.KraeverHandlingList)
                      .Name("GridKraeverHandlingList")
                      .Pageable(pager => pager.PageSizes(true).PageSizes(new[] { 10, 20, 100, 500 }).Messages(x => x.ItemsPerPage("Rækker pr. side")))
                      .Groupable(grouper => grouper
                        .Messages(messager => messager.Empty("Træk en kolonneoverskrift og slip den her for at gruppere efter denne kolonne")) //Det står også i culture filen, men den renders først efter dataene er indlæst ! Derfor sætter jeg den også her.
                        .Enabled(true)
                        )
                      .AutoBind(true)
                      .HtmlAttributes(new { style = "font-size:12px;" })
                      .Sortable()
                      .Columns(columns =>
                          {
                              columns.Bound(a => a.AnmeldelseId).Hidden(true);
                              columns.Bound(a => a.LoebeNr).Title("Løbenr.").Width("3%").Groupable(false);
                              columns.Bound(a => a.ObsOgRevision).Title("").Width("6.5%").Encoded(false);
                              columns.Bound(a => a.OprindelsesSted).Title("Oprindelsessted").Width("12%").Encoded(false);
                              columns.Bound(a => a.Jordmodtager).Title("Jordmodtager").Width("12%").Encoded(false);
                              columns.Bound(a => a.Koerselsperiode).Title("Kørsels-<br/>periode").Width("9%").Groupable(false);
                              //columns.Bound(a => a.Transportoer).Title("Transportør").Width("10%").Encoded(false);
                              columns.Bound(a => a.KoertJordMaengde).Title("Kørt/forventet<br/>jordmængde (t)").Width("10%");
                              columns.Bound(a => a.SenesteStatus).Title("Status").Encoded(false);
                              columns.Bound(a => a.JordKategoriNavn).Title("Jordkategori/<br/>klasse").Width("7%");
                              columns.Bound(a => a.IndsendtDato).Title("Indsendt").Width("9%"); 
                              columns.Bound(a => a.SagsbehandlerFJBruger).Title("Sagsbehandler").Width("8%"); //columns.Bound(a => a.AnmeldelseId).Hidden(true);
                              
                              //columns.Bound(a => a.LoebeNr).Title("Løbenr.").Width(30).Groupable(false);
                              //columns.Bound(a => a.ObsOgRevision).Title("").Width(110).Encoded(false);
                              //columns.Bound(a => a.OprindelsesSted).Title("Oprindelsessted").Width(130).Encoded(false);
                              //columns.Bound(a => a.Jordmodtager).Title("Jordmodtager").Width(130).Encoded(false);
                              //columns.Bound(a => a.Koerselsperiode).Title("Kørsels-<br/>periode").Width(80).Groupable(false);
                              //columns.Bound(a => a.Transportoer).Title("Transportør").Width(115).Encoded(false);
                              //columns.Bound(a => a.KoertJordMaengde).Title("Kørt/forventet<br/>jordmængde (t)").Width(100);
                              //columns.Bound(a => a.SenesteStatus).Title("Status").Width(140).Encoded(false);
                              //columns.Bound(a => a.JordKategoriNavn).Title("Jordkategori/<br/>klasse").Width(40);
                              //.HtmlAttributes(new { title = "#= JordKategoriNavn #", @class = "jord-kategori kategori-#= JordKategoriKode #" });

                          })
                      .DataSource(dataSource => dataSource.Ajax()
                                    .Model(model => model.Id(m => m.AnmeldelseId))
                                    .ServerOperation(false)
                                    .Read(read => read.Action("GetAnmeldelserDerKraeverHandlingAjax", "Frontpages", "backend"))
                                    .PageSize(10))
                      .Selectable(selectable => selectable
                                                    .Mode(GridSelectionMode.Single)
                                                    .Type(GridSelectionType.Row))
                      .Events(events => events.Change("GridKraeverHandlingListOnChange").DataBound("GridKraeverHandlingListDataBound")))
            </div>
            <div style="clear: both"></div>
        </div>
    </div>

    <div class="row">
        <div class="controlsbox" style="margin-top: 10px">
            <div class="cbheader">
                <h5>Mine anmeldelser</h5>
            </div>
            <div class="row">
                @(Html.Kendo().Grid(Model.MineAnmeldelserList)
                      .Name("GridMineAnmeldelserList")
                      .Pageable(pager => pager.PageSizes(true).PageSizes(new[] { 10, 20, 100, 500 }).Messages(x => x.ItemsPerPage("Rækker pr. side")))
                      .Groupable(grouper => grouper
                        .Messages(messager => messager.Empty("Træk en kolonneoverskrift og slip den her for at gruppere efter denne kolonne")) //Det står også i culture filen, men den renders først efter dataene er indlæst ! Derfor sætter jeg den også her.
                        .Enabled(true)
                      )
                      .AutoBind(false)
                      .HtmlAttributes(new { style = "font-size:12px; display:none;" })
                      .Sortable()
                      .Columns(columns =>
                          {
                              columns.Bound(a => a.AnmeldelseId).Hidden(true);
                              columns.Bound(a => a.LoebeNr).Title("Løbenr.").Width("3%").Groupable(false);
                              columns.Bound(a => a.ObsOgRevision).Title("").Width("6.5%").Encoded(false);
                              columns.Bound(a => a.OprindelsesSted).Title("Oprindelsessted").Width("14%").Encoded(false);
                              columns.Bound(a => a.Jordmodtager).Title("Jordmodtager").Width("14%").Encoded(false);
                              columns.Bound(a => a.Koerselsperiode).Title("Kørsels-<br/>periode").Width("9%").Groupable(false);
                              columns.Bound(a => a.Transportoer).Title("Transportør").Width("14%").Encoded(false);
                              columns.Bound(a => a.KoertJordMaengde).Title("Kørt/forventet<br/>jordmængde (t)").Width("10%");
                              columns.Bound(a => a.SenesteStatus).Title("Status").Encoded(false);
                              columns.Bound(a => a.JordKategoriNavn).Title("Jordkategori/<br/>klasse").Width("7%");
                              //columns.Bound(a => a.AnmeldelseId).Hidden(true);
                              //columns.Bound(a => a.LoebeNr).Title("Løbenr.").Width(30).Groupable(false);
                              //columns.Bound(a => a.ObsOgRevision).Title("").Width(110).Encoded(false);
                              //columns.Bound(a => a.OprindelsesSted).Title("Oprindelsessted").Width(130).Encoded(false);
                              //columns.Bound(a => a.Jordmodtager).Title("Jordmodtager").Width(130).Encoded(false);
                              //columns.Bound(a => a.Koerselsperiode).Title("Kørsels-<br/>periode").Width(80).Groupable(false);
                              //columns.Bound(a => a.Transportoer).Title("Transportør").Width(115).Encoded(false);
                              //columns.Bound(a => a.KoertJordMaengde).Title("Kørt/forventet<br/>jordmængde (t)").Width(100);
                              //columns.Bound(a => a.SenesteStatus).Title("Status").Width(140).Encoded(false);
                              //columns.Bound(a => a.JordKategoriNavn).Title("Kategori/<br/>klasse").Width(40);
                              //.HtmlAttributes(new { title = "#= JordKategoriNavn #", @class = "jord-kategori kategori-#= JordKategoriKode #" });

                          })
                      .DataSource(dataSource => dataSource.Ajax()
                                                          .Model(model => model.Id(m => m.AnmeldelseId))
                                                          .ServerOperation(false)
                                                          .Read(read => read.Action("GetMineAnmeldelserAjax", "Frontpages", "backend"))
                                                          .PageSize(100))
                      .Selectable(selectable => selectable
                                                    .Mode(GridSelectionMode.Single)
                                                    .Type(GridSelectionType.Row))
                    .Events(events => events.Change("GridMineAnmeldelserListOnChange").DataBound("GridMineAnmeldelserListDataBound")))
                <button id="hentMineAnmeldelser" style="cursor: pointer; margin: 10px 0 0 10px">Indlæs</button>
                <script>
                    $("#hentMineAnmeldelser").click(function () {
                        $("#GridMineAnmeldelserList")
                            .css("display", "block")
                            .data("kendoGrid")
                            .dataSource.read();
                        $(this).hide();
                    });
                </script>
            </div>
            <div style="clear: both"></div>
        </div>
    </div>
</div>
